            short(math.floor((Agility.Value - Runtime.StartStats.Agility) * perMin)),
            short(math.floor((Durability.Value - Runtime.StartStats.Durability) * perMin))))
        local landed = repsProgress and (repsProgress.Value - repsStart) or 0
