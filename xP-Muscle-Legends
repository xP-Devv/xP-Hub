-- ── UNLOAD COMPLETO ──────────────────────────────────────────
local function unloadScript()
    State.Running = false
    State.FarmMode = "Off"
    Runtime.FarmToken = Runtime.FarmToken + 1

    _G.xP_InfJump, _G.xP_LockPos, _G.xP_Noclip = false, false, false
    _G.xP_Fly, _G.xP_FlyUp, _G.xP_FlyDown = false, false, false
    _G.xP_KillAura = false

    if antiFlingBV then pcall(function() antiFlingBV:Disconnect() end); antiFlingBV = nil end

    local c = LocalPlayer.Character
    local r = c and c:FindFirstChild("HumanoidRootPart")
    if r then
        local af = r:FindFirstChild("AntiFling_BV"); if af then af:Destroy() end
        local fl = r:FindFirstChild("xP_FlyBV");     if fl then fl:Destroy() end
    end

    pcall(function() leaveMachine() end)

    pcall(function()
        Library:Notify({ Title = "xP Hub", Description = "Unloaded.", Time = 2 })
        task.wait(0.3)
        Library:Unload()
    end)
end

MenuGroup:AddButton({
    Text    = "Unload Script",
    Func    = unloadScript,
    Risky   = true,
})

