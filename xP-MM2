-- BYPASS SEGURO (interno, sem UI)
-- ============================================================
local Bypass = {
    AntiKick = true, AntiAC = true, AntiAFK = true,
    _afkConn = nil, _kickHookInstalled = false,
}

local function SafeExec(fn, ...)
    local ok, result = pcall(fn, ...)
    if ok then return result end
    return nil
end

local function InstallAntiKickHook()
    if Bypass._kickHookInstalled then return end
    if typeof(hookmetamethod) ~= "function" then return end
    if typeof(getnamecallmethod) ~= "function" then return end
    SafeExec(function()
        local oldNamecall
        oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
            local ok, method = pcall(getnamecallmethod)
            if ok and method == "Kick" and self == LP and Bypass.AntiKick then return end
            return oldNamecall(self, ...)
        end)
        Bypass._kickHookInstalled = true
    end)
end

local function InstallAntiAFK()
    if Bypass._afkConn then return end
    SafeExec(function()
        local vu = game:GetService("VirtualUser")
        Bypass._afkConn = LP.Idled:Connect(function()
            SafeExec(function()
                vu:CaptureController()
                vu:ClickButton2(Vector2.new())
            end)
        end)
    end)
end

InstallAntiKickHook()
InstallAntiAFK()

