-- ===== FUNÇÃO: CRIAR BOTÃO DE TELEPORTE =====
local function createTeleportButton(data)
    local button = Instance.new("TextButton")
    button.Size = UDim2.new(1, -8, 0, 35)
    button.Text = data.name .. "  (X:" .. math.floor(data.pos.X) ..
                  " Y:" .. math.floor(data.pos.Y) ..
                  " Z:" .. math.floor(data.pos.Z) .. ")"
    button.BackgroundColor3 = Color3.fromRGB(100, 100, 100)
    button.TextColor3 = Color3.fromRGB(255, 255, 255)
    button.TextScaled = true
    button.Font = Enum.Font.Gotham
    button.Parent = listFrame

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 6)
    corner.Parent = button

    button.MouseButton1Click:Connect(function()
        if isTeleporting then return end

        local character = player.Character
        if not character then return end

        local hrp = character:FindFirstChild("HumanoidRootPart")
        local humanoid = character:FindFirstChildOfClass("Humanoid")
        if not hrp or not humanoid or humanoid.Health <= 0 then return end

        isTeleporting = true

        -- Dá o controle de rede pro player (evita rubber-band / reset)
        pcall(function()
            hrp:SetNetworkOwner(player)
        end)

        -- Teleporta usando CFrame direto na HRP
        -- +3 no Y pra nascer levemente acima do chão e não travar
        hrp.CFrame = CFrame.new(data.pos + Vector3.new(0, 3, 0))

        task.wait(1)
        isTeleporting = false
    end)

    return button
end

-- ===== FUNÇÃO: ATUALIZAR LISTA =====
local function updateGUI()
    for _, child in pairs(listFrame:GetChildren()) do
        if child:IsA("TextButton") then
            child:Destroy()
        end
    end

    for _, data in pairs(savedPositions) do
        createTeleportButton(data)
    end

    listFrame.CanvasSize = UDim2.new(0, 0, 0, #savedPositions * 39 + 8)
end

-- ===== FUNÇÃO: SALVAR POSIÇÃO =====
local function savePosition()
    local character = player.Character
    if not character then return end

    local hrp = character:FindFirstChild("HumanoidRootPart")
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not hrp or not humanoid then return end

    -- Não salva se estiver caindo/pulando
    local state = humanoid:GetState()
    if state == Enum.HumanoidStateType.Freefall
       or state == Enum.HumanoidStateType.Jumping
       or state == Enum.HumanoidStateType.Flying then
        nameBox.Text = ""
        nameBox.PlaceholderText = "Espere pousar pra salvar!"
        task.wait(2)
        nameBox.PlaceholderText = "Nome do local"
        return
    end

    local position = hrp.Position
    local name = nameBox.Text
    if name == "" then
        name = "Lugar " .. (#savedPositions + 1)
    end

    table.insert(savedPositions, {name = name, pos = position})
    updateGUI()
    nameBox.Text = ""
end

saveButton.MouseButton1Click:Connect(savePosition)

