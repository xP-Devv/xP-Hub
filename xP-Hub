        if not targetPlayer then return false end
        if not targetPlayer.Character then return false end
        local root = targetPlayer.Character:FindFirstChild("HumanoidRootPart")
        if not root then return false end

        if bhActive then StopBlackHole() end

        bhTarget = targetPlayer
        bhActive = true

        SetupBlackHole()

        if not IsValidInstance(bhAttachment) then
            bhActive = false
            return false
        end

        for _, part in pairs(Workspace:GetDescendants()) do
            ApplyForce(part)
        end

        bhDescConn = Workspace.DescendantAdded:Connect(function(part)
            if bhActive then
                ApplyForce(part)
            end
        end)

        bhRenderConn = RunService.Heartbeat:Connect(function()
            if not bhActive or not bhTarget or not bhTarget.Character then
                StopBlackHole()
                return
