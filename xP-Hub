-- Team Select (lado esquerdo, abaixo de Aimbot Settings)
-- ============================================================
local teamSelectGroup = AimbotTab:AddLeftGroupbox("Team Select", "users")
local teamToggleContainer = {}

local function rebuildTeamToggles()
    for _, toggle in ipairs(teamToggleContainer) do
        if toggle and toggle.Destroy then
            pcall(function() toggle:Destroy() end)
        end
    end
    teamToggleContainer = {}

    local myTeam = nil
    pcall(function() myTeam = player.Team end)

    local teams = {}
    for _, plr in pairs(Players:GetPlayers()) do
        if plr ~= player and plr.Team then
            local teamName = plr.Team.Name
            if myTeam and teamName ~= myTeam.Name then
                teams[teamName] = true
            elseif not myTeam then
                teams[teamName] = true
            end
        end
    end

    for teamName in pairs(teams) do
        local toggle = teamSelectGroup:AddToggle("TeamIgnore_" .. teamName, {
            Text = "Ignorar " .. teamName,
            Default = disabledTeams[teamName] or false,
            Callback = function(value)
                if value then
                    disabledTeams[teamName] = true
                else
                    disabledTeams[teamName] = nil
                end
            end
        })
        table.insert(teamToggleContainer, toggle)
    end
end

local function scheduleTeamRebuild()
    task.spawn(function()
        task.wait(0.1)
        rebuildTeamToggles()
    end)
end

teamRebuildConn = Players.PlayerAdded:Connect(scheduleTeamRebuild)
Players.PlayerRemoving:Connect(scheduleTeamRebuild)

for _, plr in pairs(Players:GetPlayers()) do
    if plr ~= player then
        plr:GetPropertyChangedSignal("Team"):Connect(scheduleTeamRebuild)
    end
end
Players.PlayerAdded:Connect(function(newPlayer)
    if newPlayer ~= player then
        newPlayer:GetPropertyChangedSignal("Team"):Connect(scheduleTeamRebuild)
    end
end)

rebuildTeamToggles()

