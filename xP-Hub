    end

    function StartPuxarTodos()
        if puxarTodosActive then
            StopPuxarTodos()
            task.wait(0.1)
        end

        puxarTodosActive = true

        Library:Notify({ Title = "Puxar Todos", Description = "Todos os players virão até você", Time = 2 })

        puxarTodosConnection = RunService.Heartbeat:Connect(function()
            if not puxarTodosActive or not player.Character then return end

            local myChar = player.Character
            local myHRP = myChar:FindFirstChild("HumanoidRootPart")
            if not myHRP then return end

            local lookVector = Camera.CFrame.LookVector

            for _, plr in pairs(Players:GetPlayers()) do
                if plr ~= player and plr.Character then
                    local targetHRP = plr.Character:FindFirstChild("HumanoidRootPart")
                    if targetHRP then
                        local frontPos = myHRP.Position + (lookVector * 5) + Vector3.new(0, 1, 0)
                        targetHRP.CFrame = CFrame.new(frontPos)
                    end
                end
            end
        end)
    end

    function TogglePuxarTodos(value)
        if value then
            StartPuxarTodos()
        else
            StopPuxarTodos()
        end
    end
