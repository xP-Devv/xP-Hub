    function GetNearestPlayer()
        if not player.Character or not player.Character:FindFirstChild("HumanoidRootPart") then
            return nil
        end

        local myPos = player.Character.HumanoidRootPart.Position
        local closestPlayer = nil
        local closestDistance = math.huge

        for _, plr in pairs(Players:GetPlayers()) do
            if plr ~= player and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
                local targetPos = plr.Character.HumanoidRootPart.Position
                local distance = (myPos - targetPos).Magnitude

                if distance < closestDistance then
                    closestDistance = distance
                    closestPlayer = plr
                end
            end
        end

        return closestPlayer
    end

    function StopOrbit()
        orbitActive = false
        orbitTarget = nil

        if orbitConnection1 then
            orbitConnection1:Disconnect()
            orbitConnection1 = nil
        end
        if orbitConnection2 then
            orbitConnection2:Disconnect()
            orbitConnection2 = nil
        end
        if orbitConnection3 then
            orbitConnection3:Disconnect()
            orbitConnection3 = nil
        end
        if orbitConnection4 then
            orbitConnection4:Disconnect()
            orbitConnection4 = nil
        end

        local char = player.Character
        if char and char:FindFirstChild("HumanoidRootPart") then
            local hrp = char.HumanoidRootPart
            hrp.CFrame = CFrame.new(hrp.Position, hrp.Position + hrp.CFrame.LookVector)
        end
    end

    function StartOrbitNearest()
        if not orbitHotkeyEnabled then
            Library:Notify({ Title = "Orbit", Description = "Ative o Toggle Enable Orbit primeiro", Time = 2 })
            return
        end

        local nearest = GetNearestPlayer()
        if not nearest then
            Library:Notify({ Title = "Orbit", Description = "Nenhum jogador próximo", Time = 2 })
            return
        end

        if orbitActive then
            StopOrbit()
            Library:Notify({ Title = "Orbit", Description = "Desgrudou de " .. nearest.Name, Time = 1 })
            return
        end

        local targetChar = nearest.Character
        local targetRoot = targetChar and targetChar:FindFirstChild("HumanoidRootPart")
        local myChar = player.Character
        local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
        local myHumanoid = myChar and myChar:FindFirstChildOfClass("Humanoid")

        if not targetRoot or not myRoot or not myHumanoid then
            Library:Notify({ Title = "Orbit", Description = "Personagem não carregado", Time = 2 })
            return
        end

        orbitActive = true
        orbitTarget = nearest

        Library:Notify({ Title = "Orbit", Description = "Grudou em " .. nearest.Name, Time = 2 })

        local rotation = 0

        orbitConnection1 = RunService.Heartbeat:Connect(function()
            if not orbitActive or not orbitTarget or not orbitTarget.Parent then
                StopOrbit()
                return
            end

            local targetChar = orbitTarget.Character
            local targetRoot = targetChar and targetChar:FindFirstChild("HumanoidRootPart")
            local myChar = player.Character
            local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")

            if not targetRoot or not myRoot then
                StopOrbit()
                return
            end

            rotation = rotation + orbitSpeed
            myRoot.CFrame = CFrame.new(targetRoot.Position) *
                            CFrame.Angles(0, math.rad(rotation), 0) *
                            CFrame.new(orbitDistance, 0, 0)
        end)

        orbitConnection2 = RunService.RenderStepped:Connect(function()
            if not orbitActive or not orbitTarget or not orbitTarget.Parent then
                return
            end

            local targetChar = orbitTarget.Character
            local targetRoot = targetChar and targetChar:FindFirstChild("HumanoidRootPart")
            local myChar = player.Character
            local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")

            if targetRoot and myRoot then
                myRoot.CFrame = CFrame.new(myRoot.Position, targetRoot.Position)
            end
        end)

        orbitConnection3 = myHumanoid.Died:Connect(StopOrbit)
        orbitConnection4 = myHumanoid.Seated:Connect(function(value)
            if value then StopOrbit() end
        end)
    end

    function ToggleOrbit(value)
        orbitHotkeyEnabled = value

        if not value and orbitActive then
            StopOrbit()
        end

        Library:Notify({
            Title = value and "Orbit ON" or "Orbit OFF",
            Description = value and "Pressione a tecla escolhida para (off/On)" or "Tecla desativada",
            Time = 2
        })
    end

    function StopPuxarTodos()
