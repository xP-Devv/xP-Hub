-- BLOCO 7: LISTA DE PLAYERS E ESP (ALL) - HIGHLIGHT
-- ============================================================

do
    function ClearESP()
        for plr, data in pairs(espInstances) do
            if data.Highlight then data.Highlight:Destroy() end
        end
        espInstances = {}
        for plr, text in pairs(espTexts) do
            if text then text:Remove() end
        end
        espTexts = {}
    end

    function UpdateESP()
        if not espEnabled then return end
        for plr, text in pairs(espTexts) do
            if not plr or not plr.Parent then
                if text then text:Remove() end
                espTexts[plr] = nil
            else
                local char = plr.Character
                if not char then
                    text.Visible = false
                else
                    local head = char:FindFirstChild("Head")
                    if not head then
                        text.Visible = false
                    else
                        local humanoid = char:FindFirstChild("Humanoid")
                        if not humanoid or humanoid.Health <= 0 then
                            text.Visible = false
                        else
                            local headPos, onScreen = Camera:WorldToViewportPoint(head.Position + Vector3.new(0, 1.5, 0))
                            if onScreen then
                                text.Position = Vector2.new(headPos.X, headPos.Y)
                                text.Visible = true
                            else
                                text.Visible = false
                            end
                        end
                    end
                end
            end
        end
    end

    function ToggleESP(value)
        espEnabled = value

        if espEnabled then
            for _, p in pairs(Players:GetPlayers()) do
                if p ~= player then
                    local char = p.Character
                    if char then
                        local hl = Instance.new("Highlight", char)
                        hl.Name = "ESP_HL"
                        hl.FillTransparency = 0.5
                        hl.OutlineTransparency = 0
                        hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop

                        local isEnemy = false
                        pcall(function()
                            isEnemy = (p.Team ~= player.Team) and p.Team ~= nil and player.Team ~= nil
                        end)
                        hl.FillColor = isEnemy and Color3.fromRGB(255, 50, 50) or Color3.fromRGB(0, 255, 0)
                        espInstances[p] = {Highlight = hl}

                        local text = Drawing.new("Text")
                        text.Text = p.Name
                        text.Size = 16
                        text.Center = true
                        text.Outline = true
                        text.OutlineColor = Color3.fromRGB(0, 0, 0)
                        text.Color = isEnemy and Color3.fromRGB(255, 100, 100) or Color3.fromRGB(100, 255, 100)
                        text.Visible = false
                        espTexts[p] = text
                    end
                end
            end

            local newPlayerConn = Players.PlayerAdded:Connect(function(newPlayer)
                if newPlayer == player then return end
                newPlayer.CharacterAdded:Connect(function()
                    task.wait(1)
                    if espEnabled and newPlayer.Character then
                        local hl = Instance.new("Highlight", newPlayer.Character)
                        hl.Name = "ESP_HL"
                        hl.FillTransparency = 0.5
                        hl.OutlineTransparency = 0
                        hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                        local isEnemy = false
                        pcall(function()
                            isEnemy = (newPlayer.Team ~= player.Team) and newPlayer.Team ~= nil and player.Team ~= nil
                        end)
                        hl.FillColor = isEnemy and Color3.fromRGB(255, 50, 50) or Color3.fromRGB(0, 255, 0)
                        espInstances[newPlayer] = {Highlight = hl}
                        local text = Drawing.new("Text")
                        text.Text = newPlayer.Name
                        text.Size = 16
                        text.Center = true
                        text.Outline = true
                        text.OutlineColor = Color3.fromRGB(0, 0, 0)
                        text.Color = isEnemy and Color3.fromRGB(255, 100, 100) or Color3.fromRGB(100, 255, 100)
                        text.Visible = false
                        espTexts[newPlayer] = text
                    end
                end)
            end)
            table.insert(espConnections, newPlayerConn)

            if espUpdateLoop then espUpdateLoop:Disconnect() end
            espUpdateLoop = RunService.RenderStepped:Connect(UpdateESP)

        else
            ClearESP()
            if espUpdateLoop then
                espUpdateLoop:Disconnect()
                espUpdateLoop = nil
            end
            for _, conn in ipairs(espConnections) do
                if conn and conn.Disconnect then
                    pcall(function() conn:Disconnect() end)
                end
            end
            espConnections = {}
        end
    end
end

