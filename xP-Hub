-- Helpers
local function Create(Class, Properties)
    local obj = Instance.new(Class)
    for k, v in pairs(Properties) do obj[k] = v end
    return obj
end

local function AddOutline(Frame, Thickness)
    Create("Frame", { Parent = Frame, BorderSizePixel = 0, BackgroundColor3 = Color3.new(0,0,0), Position = UDim2.new(0, -Thickness, 0, -Thickness), Size = UDim2.new(1, Thickness*2, 0, Thickness), ZIndex = Frame.ZIndex - 1 })
    Create("Frame", { Parent = Frame, BorderSizePixel = 0, BackgroundColor3 = Color3.new(0,0,0), Position = UDim2.new(0, -Thickness, 1, 0), Size = UDim2.new(1, Thickness*2, 0, Thickness), ZIndex = Frame.ZIndex - 1 })
    Create("Frame", { Parent = Frame, BorderSizePixel = 0, BackgroundColor3 = Color3.new(0,0,0), Position = UDim2.new(0, -Thickness, 0, 0), Size = UDim2.new(0, Thickness, 1, 0), ZIndex = Frame.ZIndex - 1 })
    Create("Frame", { Parent = Frame, BorderSizePixel = 0, BackgroundColor3 = Color3.new(0,0,0), Position = UDim2.new(1, 0, 0, 0), Size = UDim2.new(0, Thickness, 1, 0), ZIndex = Frame.ZIndex - 1 })
end

local function GetHealthColor(current, max)
    return BorosConfig.Drawing.Healthbar.GradientRGB1:Lerp(BorosConfig.Drawing.Healthbar.GradientRGB2, current / max)
end

local function RefreshAllBorosElements()
    for name, data in pairs(BorosPlayers) do
        if data and data.Container and data.Container.Parent then
            if data.RefreshElements then
                pcall(data.RefreshElements)
            end
        else
            BorosPlayers[name] = nil
        end
    end
end

