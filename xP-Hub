            local hrp = player.Character:FindFirstChild("HumanoidRootPart")
            if not hrp then return end

            turtleBlackHoleAngle = turtleBlackHoleAngle + math.rad(2)
            local offsetX = math.cos(turtleBlackHoleAngle) * turtleBlackHoleRadius
            local offsetZ = math.sin(turtleBlackHoleAngle) * turtleBlackHoleRadius

            if turtleBlackHoleAttachment then
                turtleBlackHoleAttachment.WorldCFrame = hrp.CFrame * CFrame.new(offsetX, 0, offsetZ)
            end
        end)
