end)

-- ============================================================
-- ROTINA DE UNLOAD (LIMPEZA GERAL)
-- ============================================================
local function UnloadAll()
    -- Para o loop do Server Info
    serverLoopRunning = false

    -- Desconecta eventos principais
    if playerAddedConn then playerAddedConn:Disconnect() end
    if playerRemovingConn then playerRemovingConn:Disconnect() end
    if teamRebuildConn then teamRebuildConn:Disconnect() end

    -- Desativa todas as funcionalidades ativas
    if spectateToggleEnabled then restoreCamera() end
    if flyEnabled then ToggleFly(false) end
    if isFlyingActive then StopFlying() end
    if freecamActive then disableFreecam() end
    if aimbotEnabled then aimbotEnabled = false end
    if espMasterEnabled then
        espMasterEnabled = false
        ToggleBorosESP(false)
        if aimbotSkeletonEnabled then ToggleAimbotSkeleton(false) end
        if aimbotLinesEnabled then ToggleESPLines(false) end
    end
    if espEnabled then ToggleESP(false) end
    if loopBringActive then StopLoopBring() end
    if grudarRunning then stopGrudar() end
    if orbitActive then StopOrbit() end
    if puxarTodosActive then StopPuxarTodos() end
    if walkflingEnabled then StopWalkfling() end
    if antiflingActive then StopAntiFling() end
    if godModeActive then StopGodMode() end
    if turtleBlackHoleActive then StopTurtleBlackHole() end
    if bhActive then StopBlackHole() end
    if flingActive then toggleFlingPlayer(false) end
    if trollEnabled then Toggles.TrollToggle:SetValue(false) end
    if gogoEnabled then Toggles.GoGoGoToggle:SetValue(false) end
    if Noclipping then noclip_disable() end

    -- Desconectar conexões de loops e eventos
    if aimbotHeartbeatConn then aimbotHeartbeatConn:Disconnect() end
    if _aimbotFOVLoop then _aimbotFOVLoop:Disconnect() end

    -- Limpar Boros Players restantes
    for plrName, data in pairs(BorosPlayers) do
        RemoveBorosESP(Players:FindFirstChild(plrName) or {Name = plrName})
    end

    -- Limpar objetos Drawing
    if aimbotFOVCircle then aimbotFOVCircle:Remove() end
    for _, text in pairs(espTexts) do
        if text then pcall(text.Remove, text) end
    end
    espTexts = {}

    -- Limpar ScreenGuis
    if BorosScreenGui then BorosScreenGui:Destroy() end

    -- Limpar tabelas globais
    ignoredPlayers = {}
    disabledTeams = {}

    -- Limpar variáveis globais
    currentTarget = nil
end

-- Sobrescrever o método Unload da Library para incluir nossa limpeza
local originalUnload = Library.Unload
function Library:Unload()
    UnloadAll()
    if originalUnload then originalUnload(self) end
end

