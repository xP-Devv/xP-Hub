        camPart.CFrame = Camera.CFrame
        camPart.Parent = Workspace
        freecamCamPart = camPart

        pcall(function()
            local hrp = char:FindFirstChild("HumanoidRootPart")
            if hrp then hrp.Anchored = true end
        end)

        local renderConn = RunService.RenderStepped:Connect(function()
            if not freecamActive then return end

            local primaryPart = freecamCamPart
            if not primaryPart then return end

            Camera.CameraSubject = primaryPart

            local x, y, z = 0, 0, 0
            if dir.w then z = -1 * speed end
            if dir.a then x = -1 * speed end
            if dir.s then z = 1 * speed end
            if dir.d then x = 1 * speed end
            if dir.q then y = 1 * speed end
            if dir.e then y = -1 * speed end

            primaryPart.CFrame = CFrame.new(
                primaryPart.CFrame.p,
                (Camera.CFrame * CFrame.new(0, 0, -100)).p
            )

            local moveDir = CFrame.new(x, y, z)
            primaryPart.CFrame = primaryPart.CFrame:lerp(primaryPart.CFrame * moveDir, 0.2)
        end)
        table.insert(freecamConnections, renderConn)

        local inputBeganConn = UserInputService.InputBegan:Connect(function(input, event)
            if event then return end
            local code = input.KeyCode
            if code == Enum.KeyCode.W then dir.w = true
            elseif code == Enum.KeyCode.A then dir.a = true
            elseif code == Enum.KeyCode.S then dir.s = true
            elseif code == Enum.KeyCode.D then dir.d = true
            elseif code == Enum.KeyCode.Q then dir.q = true
            elseif code == Enum.KeyCode.E then dir.e = true
            elseif code == Enum.KeyCode.Space then dir.q = true
            end
        end)
        table.insert(freecamConnections, inputBeganConn)

        local inputEndedConn = UserInputService.InputEnded:Connect(function(input, event)
            if event then return end
            local code = input.KeyCode
            if code == Enum.KeyCode.W then dir.w = false
            elseif code == Enum.KeyCode.A then dir.a = false
            elseif code == Enum.KeyCode.S then dir.s = false
            elseif code == Enum.KeyCode.D then dir.d = false
            elseif code == Enum.KeyCode.Q then dir.q = false
            elseif code == Enum.KeyCode.E then dir.e = false
            elseif code == Enum.KeyCode.Space then dir.q = false
            end
        end)
        table.insert(freecamConnections, inputEndedConn)

        Library:Notify({ Title = "Freecam", Description = "Ativada! WASD + Q/E", Time = 2 })
    end

    function disableFreecam()
        if not freecamActive then return end
        freecamActive = false

        disconnectFreecamConnections()

        pcall(function()
            local humanoid = player.Character and player.Character:FindFirstChildWhichIsA("Humanoid")
            if humanoid then
                Camera.CameraSubject = humanoid
            end
        end)

        pcall(function()
            local char = player.Character
            if char then
                local hrp = char:FindFirstChild("HumanoidRootPart")
                if hrp then hrp.Anchored = false end
            end
        end)

        if freecamCamPart then
            freecamCamPart:Destroy()
            freecamCamPart = nil
        end

        for _, v in pairs(Workspace:GetChildren()) do
            if v:IsA("Part") and v.Transparency == 1 and v.Name == "" and v.Anchored then
                v:Destroy()
            end
        end

        Library:Notify({ Title = "Freecam", Description = "Desativada", Time = 2 })
    end
end

