    local function UpdateHealth()
        local humanoid = plr.Character and plr.Character:FindFirstChild("Humanoid")
        if not humanoid then return end
        local health_clamped = math.clamp(humanoid.Health, 0, humanoid.MaxHealth)
        local health = health_clamped / humanoid.MaxHealth
        local is_inf = false
        if humanoid.Health ~= humanoid.Health then
            health = 1
            is_inf = true
        end
        local color = GetHealthColor(health_clamped, humanoid.MaxHealth)
        Healthbar.BackgroundColor3 = color
        if BorosConfig.Drawing.Healthbar.HealthText then
            local healthtext = tostring(math.floor(health_clamped))
            if is_inf then healthtext = "inf" end
            HealthText.Text = healthtext
            if BorosConfig.Drawing.Healthbar.Lerp then
                HealthText.TextColor3 = color
            else
                HealthText.TextColor3 = BorosConfig.Drawing.Healthbar.HealthTextRGB
            end
            HealthText.Visible = true
        else
            HealthText.Visible = false
        end
    end

    local function UpdateWeapon()
        local char = plr.Character
        if char then
            local tool = char:FindFirstChildOfClass("Tool")
            Weapon.Text = tool and tool.Name or "None"
        else
            Weapon.Text = "None"
        end
    end

    local function OnChildAdded(item)
        if item:IsA("Tool") then
            UpdateWeapon()
        end
    end

    local function OnChildRemoved(item)
        if item:IsA("Tool") then
            UpdateWeapon()
        end
    end

