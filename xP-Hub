do
    function StartGodMode()
        if godModeActive then return end
        godModeActive = true

        local function applyGodMode(char)
            if not char then return end
            local humanoid = char:FindFirstChild("Humanoid")
            if not humanoid then return end

            local healthConn = humanoid:GetPropertyChangedSignal("Health"):Connect(function()
                if godModeActive and humanoid.Health < humanoid.MaxHealth then
                    humanoid.Health = humanoid.MaxHealth
                end
            end)
            table.insert(godModeConnections, healthConn)

            local heartbeatConn = RunService.Heartbeat:Connect(function()
                if godModeActive and humanoid and humanoid.Parent and humanoid.Health <= 0 then
                    humanoid.Health = humanoid.MaxHealth
                end
            end)
            table.insert(godModeConnections, heartbeatConn)
        end

        local char = player.Character
        if char then
            applyGodMode(char)
        end

        local charAddedConn = player.CharacterAdded:Connect(function(newChar)
            task.wait(0.5)
            if godModeActive then
                applyGodMode(newChar)
            end
        end)
        table.insert(godModeConnections, charAddedConn)

        Library:Notify({ Title = "God Mode", Description = "Ativado (Universal)", Time = 2 })
    end

    function StopGodMode()
        if not godModeActive then return end
        godModeActive = false

        for _, conn in ipairs(godModeConnections) do
            pcall(function() conn:Disconnect() end)
        end
        godModeConnections = {}

        Library:Notify({ Title = "God Mode", Description = "Desativado", Time = 2 })
    end

    function toggleGodMode(value)
        if value then
            StartGodMode()
        else
            StopGodMode()
        end
    end
end

