UserInputService.InputBegan:Connect(function(input)
    if input.KeyCode == Enum.KeyCode.RightAlt then
        -- Obsidian já gerencia o toggle do menu
    end

    if input.KeyCode == Enum.KeyCode.Z then
        holdingZ = true
    end

    if orbitHotkeyEnabled and input.KeyCode == orbitKey then
        StartOrbitNearest()
    end

    if freecamToggleEnabled and input.KeyCode == freecamKey then
        if freecamActive then
            disableFreecam()
        else
            enableFreecam(freecamSpeed)
        end
    end

    if aimbotHotkeyEnabled and input.KeyCode == aimbotKey then
        aimbotEnabled = not aimbotEnabled

        if aimbotEnabled then
            Library:Notify({ Title = "Aimbot ON", Description = "Locking onto nearest target (" .. aimbotPart .. ")", Time = 2 })
        else
            aimbotTarget = nil
            Library:Notify({ Title = "Aimbot OFF", Description = "Manual aiming", Time = 2 })
        end
    end

    if flyEnabled and input.KeyCode == flyToggleKey then
        if isFlyingActive then
            StopFlying()
            Library:Notify({ Title = "Fly", Description = "Desativado (tecla)", Time = 1 })
        else
            StartFlying()
            Library:Notify({ Title = "Fly", Description = "Ativado (tecla)", Time = 1 })
        end
    end

    if flyEnabled and isFlyingActive then
        if input.KeyCode == Enum.KeyCode.W then
            flyKeys["W"] = true
        elseif input.KeyCode == Enum.KeyCode.S then
            flyKeys["S"] = true
        elseif input.KeyCode == Enum.KeyCode.A then
            flyKeys["A"] = true
        elseif input.KeyCode == Enum.KeyCode.D then
            flyKeys["D"] = true
        elseif input.KeyCode == Enum.KeyCode.Space then
            flyKeys["Space"] = true
        elseif input.KeyCode == Enum.KeyCode.LeftShift then
            flyKeys["LeftShift"] = true
        end
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.KeyCode == Enum.KeyCode.Z then
        holdingZ = false
    end

    if flyEnabled and isFlyingActive then
        if input.KeyCode == Enum.KeyCode.W then
            flyKeys["W"] = nil
        elseif input.KeyCode == Enum.KeyCode.S then
            flyKeys["S"] = nil
        elseif input.KeyCode == Enum.KeyCode.A then
            flyKeys["A"] = nil
        elseif input.KeyCode == Enum.KeyCode.D then
            flyKeys["D"] = nil
        elseif input.KeyCode == Enum.KeyCode.Space then
            flyKeys["Space"] = nil
        elseif input.KeyCode == Enum.KeyCode.LeftShift then
            flyKeys["LeftShift"] = nil
        end
    end
end)

