-- FUNÇÃO IsEnemy (GLOBAL)
-- ============================================================
function IsEnemy(plr)
    if plr == player then return false end

    if ignoredPlayers[plr.Name] then
        return false
    end

    if ignoreFriends then
        local isFriend, result = pcall(function()
            return player:IsFriendsWith(plr)
        end)
        if isFriend and result then
            return false
        end
    end

    if not teamCheck then
        return true
    end

    local theirTeam = nil
    pcall(function() theirTeam = plr.Team end)
    if theirTeam and disabledTeams[theirTeam.Name] then
        return false
    end
    local myTeam = nil
    pcall(function() myTeam = player.Team end)
    if not myTeam or not theirTeam then
        return true
    end
    return myTeam ~= theirTeam
end

