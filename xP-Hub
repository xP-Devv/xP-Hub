    local bhCharConn = nil

    local function SetupBlackHole()
        if IsValidInstance(bhFolder) then
            return
        end

        if bhFolder then
            pcall(function() bhFolder:Destroy() end)
            bhFolder = nil
        end
        bhPart = nil
        bhAttachment = nil

