-- FUNÇÃO PARA ATUALIZAR A UI DE SELEÇÃO
-- ============================================================
local function updateSelectionUI()
    if alvoLabel then
        if currentTarget then
            alvoLabel:Set("🎯 Alvo: " .. currentTarget.Name)
        else
            alvoLabel:Set("🎯 Alvo: Nenhum")
        end
    end
    if statusLabel then
        if spectateToggleEnabled and currentTarget then
            statusLabel:Set("📡 Status: Spectating " .. currentTarget.Name)
        elseif spectateToggleEnabled then
            statusLabel:Set("📡 Status: Spectating (sem alvo)")
        else
            statusLabel:Set("📡 Status: Not Spectating")
        end
    end
end

-- ============================================================
-- FUNÇÃO CENTRAL PARA ATUALIZAR ALVO EM TODAS AS FEATURES
-- ============================================================
function updateAllFeaturesTarget(newTarget)
    currentTarget = newTarget

    if flingActive then
        flingTarget = newTarget
    end

    if loopBringActive then
        loopBringTarget = newTarget
    end

    if trollEnabled then
        trollTarget = newTarget
    end

    if gogoEnabled then
        gogoTarget = newTarget
    end

    if Toggles.BlackHoleToggle and Toggles.BlackHoleToggle.Value and newTarget then
        StopBlackHole()
        task.wait(0.2)
        StartBlackHole(newTarget)
    end

    if spectateToggleEnabled and newTarget then
        startSpectate(newTarget)
    else
        updateSelectionUI()
    end

    Library:Notify({
        Title = "Alvo atualizado",
        Description = newTarget and "Agora: " .. newTarget.Name or "Nenhum alvo",
        Time = 2
    })
end

function clearSelected()
    if currentTarget then
        if spectateToggleEnabled then
            restoreCamera()
        end
        currentTarget = nil
        updateSelectionUI()
        Library:Notify({
            Title = "Alvo removido",
            Description = "Nenhum jogador selecionado",
            Time = 2
        })
    end
end

-- ============================================================
-- BLOCO 1: NOCLIP E ANTI FLING
-- ============================================================

do
    function noclip_enable()
        if Noclipping then Noclipping:Disconnect() end
        Clip = false
        Noclipping = RunService.Stepped:Connect(function()
            if Clip == false and player.Character then
                for _, part in ipairs(player.Character:GetDescendants()) do
                    if part:IsA("BasePart") and part.CanCollide == true then
                        part.CanCollide = false
                    end
                end
            end
        end)
        Library:Notify({ Title = "NoClip", Description = "Ativado", Time = 2 })
    end

    function noclip_disable()
        if Noclipping then
            Noclipping:Disconnect()
            Noclipping = nil
        end
        Clip = true
        if player.Character then
            for _, part in pairs(player.Character:GetDescendants()) do
                if part:IsA("BasePart") then
                    part.CanCollide = true
                end
            end
        end
        Library:Notify({ Title = "NoClip", Description = "Desativado", Time = 2 })
    end

    function StartAntiFling()
        if antiflingActive then return end
        antiflingActive = true
        antiflingConnection = RunService.Stepped:Connect(function()
            if not antiflingActive then
                antiflingConnection:Disconnect()
                antiflingConnection = nil
                return
            end
            for _, plr in pairs(Players:GetPlayers()) do
                if plr ~= player and plr.Character then
                    for _, part in pairs(plr.Character:GetDescendants()) do
                        if part:IsA("BasePart") then
                            part.CanCollide = false
                        end
                    end
                end
            end
        end)
        Library:Notify({ Title = "Anti Fling", Description = "Ativado", Time = 2 })
    end

    function StopAntiFling()
        antiflingActive = false
        if antiflingConnection then
            antiflingConnection:Disconnect()
            antiflingConnection = nil
        end
        for _, plr in pairs(Players:GetPlayers()) do
            if plr ~= player and plr.Character then
                for _, part in pairs(plr.Character:GetDescendants()) do
                    if part:IsA("BasePart") then
                        part.CanCollide = true
                    end
                end
            end
        end
        Library:Notify({ Title = "Anti Fling", Description = "Desativado", Time = 2 })
    end
end

-- ============================================================
-- BLOCO 2: ANIMAÇÃO, ESPECTADOR, LOOP BRING, GRUDAR, JERK, TOOL
-- ============================================================

do
    function ApplyAnimation(animData)
        local char = player.Character
        if not char then return end
        local animate = char:FindFirstChild("Animate")
        if not animate then return end

        animate.Disabled = true
        local hum = char:FindFirstChild("Humanoid")
        if hum then
            for _, track in pairs(hum:GetPlayingAnimationTracks()) do
                track:Stop()
            end
        end

        if animate:FindFirstChild("idle") then
            local idle = animate.idle
            if idle:FindFirstChild("Animation1") then
                idle.Animation1.AnimationId = "http://www.roblox.com/asset/?id=" .. animData.idle1
            end
            if idle:FindFirstChild("Animation2") then
                idle.Animation2.AnimationId = "http://www.roblox.com/asset/?id=" .. animData.idle2
            end
        end
        if animate:FindFirstChild("walk") and animate.walk:FindFirstChild("WalkAnim") then
            animate.walk.WalkAnim.AnimationId = "http://www.roblox.com/asset/?id=" .. animData.walk
        end
        if animate:FindFirstChild("run") and animate.run:FindFirstChild("RunAnim") then
            animate.run.RunAnim.AnimationId = "http://www.roblox.com/asset/?id=" .. animData.run
        end
        if animate:FindFirstChild("jump") and animate.jump:FindFirstChild("JumpAnim") then
            animate.jump.JumpAnim.AnimationId = "http://www.roblox.com/asset/?id=" .. animData.jump
        end
        if animate:FindFirstChild("climb") and animate.climb:FindFirstChild("ClimbAnim") then
            animate.climb.ClimbAnim.AnimationId = "http://www.roblox.com/asset/?id=" .. animData.climb
        end
        if animate:FindFirstChild("fall") and animate.fall:FindFirstChild("FallAnim") then
            animate.fall.FallAnim.AnimationId = "http://www.roblox.com/asset/?id=" .. animData.fall
        end

        animate.Disabled = false
        if hum then
            hum:ChangeState(Enum.HumanoidStateType.Running)
        end
    end

    function restoreCamera()
        if humanoidDiedConn then
            humanoidDiedConn:Disconnect()
            humanoidDiedConn = nil
        end
        if targetAncestryConn then
            targetAncestryConn:Disconnect()
            targetAncestryConn = nil
        end

        spectateToggleEnabled = false

        if player.Character and player.Character:FindFirstChildOfClass("Humanoid") then
            Camera.CameraSubject = player.Character:FindFirstChildOfClass("Humanoid")
            Camera.CameraType = Enum.CameraType.Custom
        end

        updateSelectionUI()

        if Toggles.SpectateToggle and not _updatingToggle then
            _updatingToggle = true
            Toggles.SpectateToggle:SetValue(false)
            _updatingToggle = false
        end
    end

    function startSpectate(targetPlayer)
        if not targetPlayer then
            Library:Notify({ Title = "Erro", Description = "Nenhum alvo selecionado", Time = 3 })
            return false
        end

        if targetPlayer == player then
            Library:Notify({ Title = "Erro", Description = "Não pode espectar a si mesmo", Time = 3 })
            return false
        end

        if not targetPlayer.Character then
            Library:Notify({ Title = "Erro", Description = "Player sem personagem", Time = 3 })
            return false
        end

        local humanoid = targetPlayer.Character:FindFirstChildOfClass("Humanoid")
        if not humanoid then
            Library:Notify({ Title = "Erro", Description = "Humanoid não encontrado", Time = 3 })
            return false
        end

        if spectateToggleEnabled then
            if humanoidDiedConn then humanoidDiedConn:Disconnect() end
            if targetAncestryConn then targetAncestryConn:Disconnect() end
            spectateToggleEnabled = false
        end

        Camera.CameraSubject = humanoid
        Camera.CameraType = Enum.CameraType.Custom
        spectateToggleEnabled = true

        if humanoidDiedConn then humanoidDiedConn:Disconnect() end
        humanoidDiedConn = humanoid.Died:Connect(function()
            restoreCamera()
        end)

        if targetAncestryConn then targetAncestryConn:Disconnect() end
        targetAncestryConn = targetPlayer.AncestryChanged:Connect(function(_, parent)
            if not parent then
                if targetPlayer == currentTarget then
                    clearSelected()
                else
                    restoreCamera()
                end
            end
        end)

        updateSelectionUI()
        Library:Notify({ Title = "Espectando", Description = "Agora spectando " .. targetPlayer.Name, Time = 2 })
        return true
    end

    function selectTarget(targetPlayer)
        if not targetPlayer or targetPlayer == player then
            Library:Notify({ Title = "Erro", Description = "Player inválido", Time = 3 })
            return
        end
        if currentTarget == targetPlayer then
            Library:Notify({ Title = "Info", Description = "Já selecionado: " .. targetPlayer.Name, Time = 2 })
            return
        end
        updateAllFeaturesTarget(targetPlayer)
    end

    function teleportToSpectatedPlayer()
        if not currentTarget then
            Library:Notify({ Title = "Erro", Description = "Nenhum alvo selecionado", Time = 3 })
            return
        end

        local char = currentTarget.Character
        if not char or not char:FindFirstChild("HumanoidRootPart") then
            Library:Notify({ Title = "Erro", Description = "Alvo sem personagem", Time = 3 })
            return
        end

        local myChar = player.Character
        if not myChar or not myChar:FindFirstChild("HumanoidRootPart") then
            Library:Notify({ Title = "Erro", Description = "Você está sem personagem", Time = 3 })
            return
        end

        local targetPos = char.HumanoidRootPart.Position
        local teleportPos = targetPos + Vector3.new(5, 0, 5)

        myChar.HumanoidRootPart.CFrame = CFrame.new(teleportPos)
        Library:Notify({ Title = "Teleportado", Description = "Para " .. currentTarget.Name, Time = 2 })
    end

    function StopLoopBring()
        if isStoppingLoopBring then return end
        isStoppingLoopBring = true

        loopBringActive = false
        loopBringTarget = nil

        if loopBringConnection then
            loopBringConnection:Disconnect()
            loopBringConnection = nil
        end

        Library:Notify({ Title = "Puxar Player", Description = "Parado", Time = 2 })

        task.spawn(function()
            task.wait(0.1)
            isStoppingLoopBring = false
        end)
    end

    function StartLoopBring(targetPlayer)
        if not targetPlayer or targetPlayer == player then
            Library:Notify({ Title = "Erro", Description = "Player inválido", Time = 2 })
            return
        end

        if loopBringActive then
            StopLoopBring()
            task.wait(0.1)
        end

        loopBringActive = true
        loopBringTarget = targetPlayer

        Library:Notify({ Title = "Puxar Player", Description = "Puxando " .. targetPlayer.Name, Time = 2 })

        loopBringConnection = RunService.Heartbeat:Connect(function()
            if not loopBringActive or not loopBringTarget or not loopBringTarget.Parent then
                StopLoopBring()
                return
            end

            local targetChar = loopBringTarget.Character
            local myChar = player.Character

            if not targetChar or not myChar then return end

            local targetHRP = targetChar:FindFirstChild("HumanoidRootPart")
            local myHRP = myChar:FindFirstChild("HumanoidRootPart")

            if targetHRP and myHRP then
                local lookVector = Camera.CFrame.LookVector
                local frontPos = myHRP.Position + (lookVector * 5) + Vector3.new(0, 1, 0)
                targetHRP.CFrame = CFrame.new(frontPos)
            end
        end)
    end

    function toggleLoopBring(value)
        if value then
            if currentTarget then
                StartLoopBring(currentTarget)
            else
                Library:Notify({ Title = "Erro", Description = "Selecione um alvo primeiro", Time = 3 })
            end
        else
            StopLoopBring()
        end
    end

    function startGrudar()
        if not currentTarget then
            Library:Notify({ Title = "Erro", Description = "Nenhum alvo selecionado", Time = 3 })
            return
        end
        if grudarRunning then
            Library:Notify({ Title = "Info", Description = "Já está grudado", Time = 2 })
            return
        end
        grudarRunning = true
        grudarConnection = RunService.Stepped:Connect(function()
            if not grudarRunning then
                grudarConnection:Disconnect()
                grudarConnection = nil
                return
            end
            local localChar = player.Character
            local targetChar = currentTarget.Character
            if not localChar or not targetChar then return end
            local localHRP = localChar:FindFirstChild("HumanoidRootPart")
            local targetHRP = targetChar:FindFirstChild("HumanoidRootPart")
            if localHRP and targetHRP then
                localHRP.CFrame = targetHRP.CFrame * CFrame.new(0, 2.3, -1.1) * CFrame.Angles(0, math.pi, 0)
                localHRP.Velocity = Vector3.new(0, 0, 0)
            end
        end)
        Library:Notify({ Title = "Mamada", Description = "Grudado em " .. currentTarget.Name, Time = 3 })
    end

    function stopGrudar()
        grudarRunning = false
        if grudarConnection then
            grudarConnection:Disconnect()
            grudarConnection = nil
        end
        Library:Notify({ Title = "Mamada", Description = "Parada", Time = 2 })
    end

    function toggleJerk()
        if jerkActiveGlobal then
            if jerkToolGlobal then
                jerkToolGlobal:Destroy()
                jerkToolGlobal = nil
            end
            jerkActiveGlobal = false
            Library:Notify({ Title = "Jerk", Description = "Parado", Time = 2 })
            return
        end

        local humanoid = player.Character and player.Character:FindFirstChild("Humanoid")
        local backpack = player:FindFirstChild("Backpack")
        if not humanoid or not backpack then
            Library:Notify({ Title = "Erro", Description = "Personagem não carregado", Time = 2 })
            return
        end

        jerkActiveGlobal = true
        local tool = Instance.new("Tool")
        tool.Name = "Jerk Off"
        tool.ToolTip = "in the stripped club. straight up 'jorking it'"
        tool.RequiresHandle = false
        tool.Parent = backpack

        local track = nil
        local jorkin = false
        local isR15 = humanoid.RigType == Enum.HumanoidRigType.R15

        local function stopAnimation()
            jorkin = false
            if track then
                track:Stop()
                track = nil
            end
        end

        tool.Equipped:Connect(function()
            jorkin = true
            task.spawn(function()
                while jorkin and jerkActiveGlobal do
                    if not track then
                        local anim = Instance.new("Animation")
                        anim.AnimationId = isR15 and "rbxassetid://698251653" or "rbxassetid://72042024"
                        track = humanoid:LoadAnimation(anim)
                    end
                    track:Play()
                    track:AdjustSpeed(isR15 and 0.7 or 0.65)
                    track.TimePosition = 0.6
                    task.wait(0.1)
                    while track and track.TimePosition < (isR15 and 0.7 or 0.65) do
                        task.wait(0.1)
                    end
                    if track then
                        track:Stop()
                        track = nil
                    end
                end
            end)
        end)

        tool.Unequipped:Connect(stopAnimation)

        local deathConn
        deathConn = humanoid.Died:Connect(function()
            if tool then tool:Destroy() end
            jerkActiveGlobal = false
            if deathConn then deathConn:Disconnect() end
        end)

