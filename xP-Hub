            if isFlyingActive then
                StopFlying()
                Library:Notify({ Title = "Fly", Description = "Desativado (Toggle OFF)", Time = 1 })
            end
        else
            Library:Notify({ Title = "Fly", Description = "Pronto! Pressione a tecla escolhida para voar", Time = 2 })
        end
    end

    RunService.RenderStepped:Connect(function(delta)
        if flyEnabled and isFlyingActive and flyBV and player.Character then
            local T = player.Character:FindFirstChild("HumanoidRootPart")
            if not T then return end

            local velocity = Vector3.new(0, 0, 0)
            local camCF = Camera.CFrame

            if flyKeys["W"] then
                velocity = velocity + (camCF.LookVector * flySpeed)
            end
            if flyKeys["S"] then
                velocity = velocity - (camCF.LookVector * flySpeed)
            end
            if flyKeys["A"] then
                velocity = velocity - (camCF.RightVector * flySpeed)
            end
            if flyKeys["D"] then
                velocity = velocity + (camCF.RightVector * flySpeed)
            end
            if flyKeys["Space"] then
                velocity = velocity + Vector3.new(0, flySpeed, 0)
            end
            if flyKeys["LeftShift"] then
                velocity = velocity - Vector3.new(0, flySpeed, 0)
            end

            flyBV.Velocity = velocity

