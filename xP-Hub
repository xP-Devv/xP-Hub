            local oscillation = math.sin(trollTimeOffset) * 3
            local verticalOffset = math.sin(trollTimeOffset * 2) * 0.6

            local targetPos = thrp.Position
                - thrp.CFrame.LookVector * (baseDistance + oscillation)
                + Vector3.new(0, verticalOffset, 0)

            local shake = Vector3.new(
                math.random(-10,10) / 70,
                math.random(-10,10) / 70,
                0
            )

            hrp.CFrame = CFrame.lookAt(targetPos + shake, thrp.Position)
        end)

