-- ============================================================
-- FUNÇÃO DE VISIBILITY CHECK
-- ============================================================
function IsVisible(character, worldPos)
    if not aimbotVisCheck then return true end
    local origin = Camera.CFrame.Position
    local direction = worldPos - origin
    local rayParams = RaycastParams.new()
    rayParams.FilterDescendantsInstances = {player.Character, Camera}
    rayParams.FilterType = Enum.RaycastFilterType.Blacklist
    local result = Workspace:Raycast(origin, direction, rayParams)
    if result and result.Instance then
        return result.Instance:IsDescendantOf(character)
    end
    return true
end

-- ============================================================
-- BLOCO 10: AIMBOT SKELETON (DRAWING) - CORRIGIDO
-- ============================================================

do
    local function EnsureSkeletonForPlayer(plr)
        if not aimbotSkeletonEnabled or not espMasterEnabled then return end
        if plr == player then return end
        if not IsEnemy(plr) then return end
        if not plr.Character then return end
        if aimbotSkeletonObjects[plr] then return end
        CreateAimbotSkeletonForPlayer(plr)
    end

    function CreateAimbotSkeletonForPlayer(plr)
        if not aimbotSkeletonEnabled or not espMasterEnabled then return end
        if plr == player then return end
        if not IsEnemy(plr) then return end
        if not plr.Character then return end

        if aimbotSkeletonObjects[plr] then
            for _, lineData in pairs(aimbotSkeletonObjects[plr].Lines) do
                if lineData[1] then lineData[1]:Remove() end
            end
            aimbotSkeletonObjects[plr] = nil
        end

        local char = plr.Character
        local humanoid = char:FindFirstChild("Humanoid")
        if not humanoid or humanoid.Health <= 0 then return end

        local lines = {}
        local lineColor = espSkeletonColor

        local upperTorso = char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso")
        local lowerTorso = char:FindFirstChild("LowerTorso") or char:FindFirstChild("Torso")
        local head = char:FindFirstChild("Head")

        local leftUpperArm = char:FindFirstChild("LeftUpperArm") or char:FindFirstChild("Left Arm")
        local leftLowerArm = char:FindFirstChild("LeftLowerArm") or char:FindFirstChild("Left Arm")
        local leftHand = char:FindFirstChild("LeftHand") or char:FindFirstChild("Left Arm")

        local rightUpperArm = char:FindFirstChild("RightUpperArm") or char:FindFirstChild("Right Arm")
        local rightLowerArm = char:FindFirstChild("RightLowerArm") or char:FindFirstChild("Right Arm")
        local rightHand = char:FindFirstChild("RightHand") or char:FindFirstChild("Right Arm")

        local leftUpperLeg = char:FindFirstChild("LeftUpperLeg") or char:FindFirstChild("Left Leg")
        local leftLowerLeg = char:FindFirstChild("LeftLowerLeg") or char:FindFirstChild("Left Leg")
        local leftFoot = char:FindFirstChild("LeftFoot") or char:FindFirstChild("Left Leg")

        local rightUpperLeg = char:FindFirstChild("RightUpperLeg") or char:FindFirstChild("Right Leg")
        local rightLowerLeg = char:FindFirstChild("RightLowerLeg") or char:FindFirstChild("Right Leg")
        local rightFoot = char:FindFirstChild("RightFoot") or char:FindFirstChild("Right Leg")

        local function addLine(partA, partB)
            if partA and partB and partA ~= partB then
                local line = Drawing.new("Line")
                line.Visible = true
                line.Color = lineColor
                line.Thickness = 1
                line.Transparency = 0.5
                table.insert(lines, {line, partA, partB})
            end
        end

        if upperTorso and lowerTorso and upperTorso ~= lowerTorso then
            addLine(lowerTorso, upperTorso)
        end
        addLine(upperTorso, head)
        addLine(upperTorso, leftUpperArm)
        addLine(leftUpperArm, leftLowerArm)
        addLine(leftLowerArm, leftHand)
        addLine(upperTorso, rightUpperArm)
        addLine(rightUpperArm, rightLowerArm)
        addLine(rightLowerArm, rightHand)
        addLine(lowerTorso, leftUpperLeg)
        addLine(leftUpperLeg, leftLowerLeg)
        addLine(leftLowerLeg, leftFoot)
        addLine(lowerTorso, rightUpperLeg)
        addLine(rightUpperLeg, rightLowerLeg)
        addLine(rightLowerLeg, rightFoot)

        aimbotSkeletonObjects[plr] = {Lines = lines, Character = char}
    end

    function UpdateAimbotSkeletonLines()
        if not aimbotSkeletonEnabled or not espMasterEnabled then
            for plr, data in pairs(aimbotSkeletonObjects) do
                for _, lineData in ipairs(data.Lines) do
                    if lineData[1] then lineData[1].Visible = false end
                end
            end
            return
        end

        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= player and IsEnemy(plr) and plr.Character then
                if not aimbotSkeletonObjects[plr] then
                    EnsureSkeletonForPlayer(plr)
                end
            end
        end

        for plr, data in pairs(aimbotSkeletonObjects) do
            if not plr or not plr.Parent then
                for _, lineData in ipairs(data.Lines) do
                    if lineData[1] then lineData[1]:Remove() end
                end
                aimbotSkeletonObjects[plr] = nil
            else
                if not IsEnemy(plr) then
                    for _, lineData in ipairs(data.Lines) do
                        if lineData[1] then lineData[1]:Remove() end
                    end
                    aimbotSkeletonObjects[plr] = nil
                else
                    local char = plr.Character
                    if not char then
                        for _, lineData in ipairs(data.Lines) do
                            if lineData[1] then lineData[1].Visible = false end
                        end
                    else
                        local humanoid = char:FindFirstChild("Humanoid")
                        if not humanoid or humanoid.Health <= 0 then
                            for _, lineData in ipairs(data.Lines) do
                                if lineData[1] then lineData[1].Visible = false end
                            end
                        else
                            local lineColor = espSkeletonColor
                            for _, lineData in ipairs(data.Lines) do
                                local line, partA, partB = lineData[1], lineData[2], lineData[3]
                                if line then
                                    line.Color = lineColor
                                end
                                if line and partA and partB and partA.Parent and partB.Parent then
                                    local distA = (Camera.CFrame.Position - partA.Position).Magnitude
                                    if distA > BorosConfig.MaxDistance then
                                        line.Visible = false
                                    else
                                        local posA, onScreenA = Camera:WorldToViewportPoint(partA.Position)
                                        if onScreenA then
                                            local posB, onScreenB = Camera:WorldToViewportPoint(partB.Position)
                                            if onScreenB then
                                                line.From = Vector2.new(posA.X, posA.Y)
                                                line.To = Vector2.new(posB.X, posB.Y)
                                                line.Visible = true
                                            else
                                                line.Visible = false
                                            end
                                        else
                                            line.Visible = false
                                        end
                                    end
                                elseif line then
                                    line.Visible = false
                                end
                            end
                        end
                    end
                end
            end
        end
    end

    function RemoveAllAimbotSkeletons()
        for plr, data in pairs(aimbotSkeletonObjects) do
            for _, lineData in ipairs(data.Lines) do
                if lineData[1] then lineData[1]:Remove() end
            end
        end
        aimbotSkeletonObjects = {}
    end

    local function ClearSkeletonCharAddedConns()
        for _, conn in pairs(aimbotSkeletonCharAddedConns) do
            pcall(function() conn:Disconnect() end)
        end
        aimbotSkeletonCharAddedConns = {}
    end

    function ToggleAimbotSkeleton(value)
        aimbotSkeletonEnabled = value
        if not espMasterEnabled and value then
            Library:Notify({ Title = "Aviso", Description = "Ative o Enable ESP primeiro", Time = 2 })
            Toggles.AimbotSkeletonToggle:SetValue(false)
            return
        end

        if aimbotSkeletonEnabled then
            for _, plr in ipairs(Players:GetPlayers()) do
                if plr ~= player and IsEnemy(plr) and plr.Character then
                    CreateAimbotSkeletonForPlayer(plr)
                end
            end

            if aimbotSkeletonUpdateLoop then aimbotSkeletonUpdateLoop:Disconnect() end
            aimbotSkeletonUpdateLoop = RunService.RenderStepped:Connect(UpdateAimbotSkeletonLines)

            ClearSkeletonCharAddedConns()

            local function onPlayerAdded(newPlayer)
                if newPlayer ~= player and IsEnemy(newPlayer) then
                    task.wait(0.5)
                    if aimbotSkeletonEnabled and newPlayer.Character then
                        CreateAimbotSkeletonForPlayer(newPlayer)
                    end
                    local conn = newPlayer.CharacterAdded:Connect(function()
                        task.wait(0.5)
                        if aimbotSkeletonEnabled and IsEnemy(newPlayer) and newPlayer.Character then
                            CreateAimbotSkeletonForPlayer(newPlayer)
                        end
                    end)
                    table.insert(aimbotSkeletonCharAddedConns, conn)
                end
            end

            if aimbotSkeletonPlayerAddedConn then aimbotSkeletonPlayerAddedConn:Disconnect() end
            aimbotSkeletonPlayerAddedConn = Players.PlayerAdded:Connect(onPlayerAdded)

            for _, plr in ipairs(Players:GetPlayers()) do
                if plr ~= player and IsEnemy(plr) then
                    local conn = plr.CharacterAdded:Connect(function()
                        task.wait(0.5)
                        if aimbotSkeletonEnabled and IsEnemy(plr) and plr.Character then
                            CreateAimbotSkeletonForPlayer(plr)
                        end
                    end)
                    table.insert(aimbotSkeletonCharAddedConns, conn)
                end
            end

            Library:Notify({ Title = "ESP Skeleton ON", Description = "Esqueleto ativado (cor personalizável)", Time = 2 })
        else
            RemoveAllAimbotSkeletons()
            if aimbotSkeletonUpdateLoop then
                aimbotSkeletonUpdateLoop:Disconnect()
                aimbotSkeletonUpdateLoop = nil
            end
            if aimbotSkeletonPlayerAddedConn then
                aimbotSkeletonPlayerAddedConn:Disconnect()
                aimbotSkeletonPlayerAddedConn = nil
            end
            ClearSkeletonCharAddedConns()
            Library:Notify({ Title = "ESP Skeleton OFF", Description = "Esqueleto desativado", Time = 2 })
        end
    end
end

-- ============================================================
-- BLOCO 11: AIMBOT LINES (DRAWING) - CORRIGIDO
-- ============================================================

do
    function CreateESPLine(plr)
        if plr == player then return nil end
        if not IsEnemy(plr) then return nil end
        if not plr or not plr.Parent then return nil end
        if aimbotLinesTable[plr] then return aimbotLinesTable[plr] end

        local line = Drawing.new("Line")
        line.Visible = false
        line.Thickness = 1.2
        line.Transparency = 0.8
        line.Color = espLinesColor

        aimbotLinesTable[plr] = {
            Line = line,
            Player = plr,
            IsEnemy = true
        }

        return aimbotLinesTable[plr]
    end

    local function EnsureLinesForAllEnemies()
        if not aimbotLinesEnabled or not espMasterEnabled then return end
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= player and IsEnemy(plr) and plr.Character then
                if not aimbotLinesTable[plr] then
                    CreateESPLine(plr)
                end
            end
        end
    end

    function UpdateESPLine(plr)
        if not aimbotLinesEnabled or not espMasterEnabled then
            if aimbotLinesTable[plr] and aimbotLinesTable[plr].Line then
                aimbotLinesTable[plr].Line.Visible = false
            end
            return
        end
        if not IsEnemy(plr) then
            if aimbotLinesTable[plr] then
                RemoveESPLine(plr)
            end
            return
        end

        local lineData = aimbotLinesTable[plr]
        if not lineData then
            if not plr.Character then return end
            lineData = CreateESPLine(plr)
            if not lineData then return end
        end

        local char = plr.Character
        if not char then
            if lineData.Line then
                lineData.Line.Visible = false
            end
            return
        end

        local hrp = char:FindFirstChild("HumanoidRootPart")
        if not hrp then
            if lineData.Line then
                lineData.Line.Visible = false
            end
            return
        end

        local dist = (Camera.CFrame.Position - hrp.Position).Magnitude
        if dist > BorosConfig.MaxDistance then
            if lineData.Line then
                lineData.Line.Visible = false
            end
            return
        end

        local screenPos, onScreen = Camera:WorldToViewportPoint(hrp.Position)
        if not onScreen then
            lineData.Line.Visible = false
            return
        end

        local targetPos = Vector2.new(screenPos.X, screenPos.Y)
        local screenSize = Camera.ViewportSize
        local startPos = Vector2.new(screenSize.X / 2, screenSize.Y - 100)

        lineData.Line.From = startPos
        lineData.Line.To = targetPos
        lineData.Line.Visible = true
        lineData.Line.Color = espLinesColor

        if dist < 50 then
            lineData.Line.Thickness = 2.0
        elseif dist < 100 then
            lineData.Line.Thickness = 1.8
        elseif dist < 200 then
            lineData.Line.Thickness = 1.5
        else
            lineData.Line.Thickness = 1.2
        end
    end

    function RemoveESPLine(plr)
        if aimbotLinesTable[plr] then
            if aimbotLinesTable[plr].Line then
                aimbotLinesTable[plr].Line:Remove()
            end
            aimbotLinesTable[plr] = nil
        end
    end

    local function ClearLinesCharAddedConns()
        for _, conn in pairs(espLinesCharAddedConns) do
            pcall(function() conn:Disconnect() end)
        end
        espLinesCharAddedConns = {}
    end

    function ToggleESPLines(value)
        aimbotLinesEnabled = value
        if not espMasterEnabled and value then
            Library:Notify({ Title = "Aviso", Description = "Ative o Enable ESP primeiro", Time = 2 })
            Toggles.AimbotLinesToggle:SetValue(false)
            return
        end

        if aimbotLinesEnabled then
            for _, plr in ipairs(Players:GetPlayers()) do
                if plr ~= player and IsEnemy(plr) and plr.Character then
                    CreateESPLine(plr)
                end
            end

            if espLinesPlayerRemovingConn then espLinesPlayerRemovingConn:Disconnect() end
            espLinesPlayerRemovingConn = Players.PlayerRemoving:Connect(function(plr)
                if aimbotLinesTable[plr] then
                    RemoveESPLine(plr)
                end
            end)

            local playerAddedConn = Players.PlayerAdded:Connect(function(newPlayer)
                if newPlayer ~= player and IsEnemy(newPlayer) then
                    task.wait(1)
                    if aimbotLinesEnabled and newPlayer.Character then
                        CreateESPLine(newPlayer)
                    end
                    local conn = newPlayer.CharacterAdded:Connect(function()
                        task.wait(0.5)
                        if aimbotLinesEnabled and IsEnemy(newPlayer) and newPlayer.Character then
                            CreateESPLine(newPlayer)
                        end
                    end)
                    table.insert(espLinesCharAddedConns, conn)
                end
            end)
            table.insert(espLinesConnections, playerAddedConn)

            for _, plr in ipairs(Players:GetPlayers()) do
                if plr ~= player and IsEnemy(plr) then
                    local conn = plr.CharacterAdded:Connect(function()
                        task.wait(0.5)
                        if aimbotLinesEnabled and IsEnemy(plr) and plr.Character then
                            CreateESPLine(plr)
                        end
                    end)
                    table.insert(espLinesCharAddedConns, conn)
                end
            end

            local updateLoop = RunService.RenderStepped:Connect(function()
                if not aimbotLinesEnabled then
                    updateLoop:Disconnect()
                    return
                end
                EnsureLinesForAllEnemies()
                for plr, lineData in pairs(aimbotLinesTable) do
                    if not plr or not plr.Parent or not IsEnemy(plr) then
                        RemoveESPLine(plr)
                    else
                        UpdateESPLine(plr)
                    end
                end
            end)
            table.insert(espLinesConnections, updateLoop)

            Library:Notify({ Title = "ESP Lines ON", Description = "Linhas ativadas (cor personalizável)", Time = 2 })
        else
            for plr, _ in pairs(aimbotLinesTable) do
                RemoveESPLine(plr)
            end
            aimbotLinesTable = {}

            for i, conn in ipairs(espLinesConnections) do
                if conn and conn.Disconnect then
                    pcall(function() conn:Disconnect() end)
                end
            end
            espLinesConnections = {}
            if espLinesPlayerRemovingConn then
                espLinesPlayerRemovingConn:Disconnect()
                espLinesPlayerRemovingConn = nil
            end
            ClearLinesCharAddedConns()
            Library:Notify({ Title = "ESP Lines OFF", Description = "Linhas desativadas", Time = 2 })
        end
    end

    function GetBodyPart(char, partName)
        if not char then return nil end

        if partName == "Head" then
            return char:FindFirstChild("Head")
        elseif partName == "Chest" then
            return char:FindFirstChild("Torso") or char:FindFirstChild("UpperTorso")
        elseif partName == "HumanoidRootPart" then
            return char:FindFirstChild("HumanoidRootPart")
        elseif partName == "LeftLeg" then
            return char:FindFirstChild("Left Leg") or char:FindFirstChild("LeftLowerLeg")
        elseif partName == "RightLeg" then
            return char:FindFirstChild("Right Leg") or char:FindFirstChild("RightLowerLeg")
        elseif partName == "Random" then
            local parts = {"Head", "Chest", "LeftLeg", "RightLeg"}
            local randomPart = parts[math.random(1, #parts)]
            return GetBodyPart(char, randomPart)
        end

        return char:FindFirstChild("HumanoidRootPart")
    end

    function FindAimbotTarget()
        if not aimbotEnabled or not player.Character then return nil end

        local bestTarget = nil
        local closestDistance = math.huge
        local playerPos = Camera.CFrame.Position

        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= player and plr.Character then
                local char = plr.Character
                local humanoid = char:FindFirstChild("Humanoid")
                local hrp = char:FindFirstChild("HumanoidRootPart")

                if humanoid and humanoid.Health > 0 and hrp then
                    if not IsEnemy(plr) then
                        -- skip
                    else
                        local targetPos = hrp.Position
                        local distance = (playerPos - targetPos).Magnitude

                        if distance > aimbotMaxDistance then
                            continue
                        end

                        if not IsVisible(char, targetPos) then
                            continue
                        end

                        local screenPos, onScreen = Camera:WorldToViewportPoint(targetPos)

                        if onScreen then
                            local screenCenter = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
                            local targetScreenPos = Vector2.new(screenPos.X, screenPos.Y)
                            local distanceFromCenter = (targetScreenPos - screenCenter).Magnitude

                            if targetNearest then
                                if distance < closestDistance and distanceFromCenter <= aimbotFOV then
                                    closestDistance = distance
                                    bestTarget = plr
                                end
                            else
                                if distanceFromCenter < closestDistance and distanceFromCenter <= aimbotFOV then
                                    closestDistance = distanceFromCenter
                                    bestTarget = plr
                                end
                            end
                        end
                    end
                end
            end
        end

        return bestTarget
    end

    local aimbotHeartbeatConn = nil

    function AimAtTarget(target)
        if not target or not target.Character then return end

        local bodyPart = GetBodyPart(target.Character, aimbotPart)
        if not bodyPart then
            bodyPart = target.Character:FindFirstChild("HumanoidRootPart")
            if not bodyPart then return end
        end

        local targetPos = bodyPart.Position

        if aimbotPart == "Head" then
            targetPos = targetPos + Vector3.new(0, 0.25, 0)
        elseif aimbotPart == "Chest" then
            targetPos = targetPos + Vector3.new(0, 0.5, 0)
        elseif aimbotPart == "HumanoidRootPart" then
            targetPos = targetPos + Vector3.new(0, 0.8, 0)
        elseif aimbotPart == "LeftLeg" or aimbotPart == "RightLeg" then
            targetPos = targetPos + Vector3.new(0, 0.3, 0)
        end

        local currentCF = Camera.CFrame
        local targetCF = CFrame.new(currentCF.Position, targetPos)

        local smoothFactor = aimbotSmoothness * 2
        local smoothCF = currentCF:Lerp(targetCF, smoothFactor)

        if math.random(1, 100) > 95 then
            local slightOffset = Vector3.new(
                (math.random() - 0.5) * 0.05,
                (math.random() - 0.5) * 0.05,
                (math.random() - 0.5) * 0.05
            )
            smoothCF = smoothCF * CFrame.new(slightOffset)
        end

        Camera.CFrame = smoothCF
    end

    local function StartAimbotLoop()
        if aimbotHeartbeatConn then aimbotHeartbeatConn:Disconnect() end
        aimbotHeartbeatConn = RunService.Heartbeat:Connect(function()
            if aimbotEnabled then
                aimbotTarget = FindAimbotTarget()
                if aimbotTarget then
                    AimAtTarget(aimbotTarget)
                end
            end
        end)
    end

    local function StartFOVLoop()
        local fovConn
        fovConn = RunService.Heartbeat:Connect(function()
            UpdateAimbotFOVCircle()
        end)
        table.insert(freecamConnections, fovConn)
        _aimbotFOVLoop = fovConn
    end

    StartAimbotLoop()
    StartFOVLoop()
    CreateAimbotFOVCircle()
end

-- ============================================================
-- BLOCO 12: FLING PLAYER
-- ============================================================

do
    local function getRoot(plr)
        if plr and plr.Character then
            return plr.Character:FindFirstChild("HumanoidRootPart")
        end
        return nil
    end

    local function getPing()
        return (Stats.Network.ServerStatsItem["Data Ping"]:GetValue()) / 1000
    end

    local function predictionTP(target)
        if not target or not target.Character then return end
        local rootTarget = getRoot(target)
        local rootPlr = getRoot(player)
        if not rootTarget or not rootPlr then return end
        local pos = rootTarget.Position
        local vel = rootTarget.Velocity
        local ping = getPing()
        local predictedPos = pos + vel * (ping * 3.5)
        rootPlr.CFrame = CFrame.new(predictedPos)
    end

    local flingLoopRunning = false
    local flingLoopConnection = nil

    local function startFlingLoop()
        if flingLoopRunning then return end
        flingLoopRunning = true
        flingLoopConnection = RunService.Heartbeat:Connect(function()
            if not flingLoopRunning then
                flingLoopConnection:Disconnect()
                flingLoopConnection = nil
                return
            end
            local root = getRoot(player)
            if not root then return end
            local currentVel = root.Velocity
            root.Velocity = Vector3.new(math.random(-150, 150), -25000, math.random(-150, 150))
            task.wait()
            root.Velocity = currentVel
        end)
    end

    local function stopFlingLoop()
        flingLoopRunning = false
        if flingLoopConnection then
            flingLoopConnection:Disconnect()
            flingLoopConnection = nil
        end
    end

    function toggleFlingPlayer(value)
        if value then
            if not currentTarget then
                Library:Notify({ Title = "Erro", Description = "Selecione um player primeiro", Time = 3 })
                return
            end

            local root = getRoot(player)
            if root then
                flingStartPos = root.Position
            else
                flingStartPos = nil
            end

            flingActive = true
            flingTarget = currentTarget

            startFlingLoop()

            if flingTeleportConnection then flingTeleportConnection:Disconnect() end
            flingTeleportConnection = RunService.Heartbeat:Connect(function()
                if not flingActive or not flingTarget or not flingTarget.Character then
                    toggleFlingPlayer(false)
                    return
                end
                predictionTP(flingTarget)
            end)

            Library:Notify({ Title = "Fling Player", Description = "Ativado em " .. flingTarget.Name, Time = 2 })

        else
            flingActive = false
            flingTarget = nil

            stopFlingLoop()
            if flingTeleportConnection then
                flingTeleportConnection:Disconnect()
                flingTeleportConnection = nil
            end

            if flingStartPos then
                local root = getRoot(player)
                if root then
                    root.CFrame = CFrame.new(flingStartPos)
                    root.Velocity = Vector3.new(0, 0, 0)
                end
                flingStartPos = nil
            end

            Library:Notify({ Title = "Fling Player", Description = "Desativado", Time = 2 })
        end
    end
end

