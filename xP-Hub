    local function SetupCharacter(char)
        local hum = char:WaitForChild("Humanoid")
        borosConns.HealthChanged = hum.HealthChanged:Connect(UpdateHealth)
        borosConns.ChildAdded = char.ChildAdded:Connect(OnChildAdded)
        borosConns.ChildRemoved = char.ChildRemoved:Connect(OnChildRemoved)
        UpdateWeapon()
        RefreshElements()
    end

    if plr.Character then
        SetupCharacter(plr.Character)
    end
    local charAddedConn = plr.CharacterAdded:Connect(SetupCharacter)

    local function HideAllElements()
        Name.Visible = false
        Distance.Visible = false
        Weapon.Visible = false
        Box.Visible = false
        Healthbar.Visible = false
        BehindHealthbar.Visible = false
        HealthText.Visible = false
        Chams.Enabled = false
        LeftTop.Visible = false
        LeftSide.Visible = false
        RightTop.Visible = false
        RightSide.Visible = false
        BottomSide.Visible = false
        BottomDown.Visible = false
        BottomRightSide.Visible = false
        BottomRightDown.Visible = false
        Outline.Enabled = false
    end

    local renderConn = RunService.RenderStepped:Connect(function()
        if not espMasterEnabled or not BorosConfig.Enabled then
            HideAllElements()
            return
        end

        if not plr.Character or not player.Character then
            HideAllElements()
            return
        end

        if not IsEnemy(plr) then
            HideAllElements()
            return
        end

        local hrp = plr.Character:FindFirstChild("HumanoidRootPart")
        local hum = plr.Character:FindFirstChild("Humanoid")

        if not hrp or not hum or hum.Health <= 0 then
            HideAllElements()
            return
        end

        local pos, onScreen = Camera:WorldToScreenPoint(hrp.Position)
        local dist = (Camera.CFrame.Position - hrp.Position).Magnitude

        if onScreen and dist <= BorosConfig.MaxDistance then
            local size = hrp.Size.Y
            local scaleFactor = (size * Camera.ViewportSize.Y) / (pos.Z * 2)
            local w = 3 * scaleFactor
            local h = 4.5 * scaleFactor

            if BorosConfig.FadeOut.OnDistance then
                local transparency = math.max(0.1, 1 - (dist / BorosConfig.MaxDistance))
                Name.TextTransparency = 1 - transparency
                Distance.TextTransparency = 1 - transparency
                Weapon.TextTransparency = 1 - transparency
                Healthbar.BackgroundTransparency = 1 - transparency
                BehindHealthbar.BackgroundTransparency = 1 - transparency
                HealthText.TextTransparency = 1 - transparency
                Box.BackgroundTransparency = 1 - transparency
                LeftTop.Transparency = 1 - transparency
                LeftSide.Transparency = 1 - transparency
                BottomSide.Transparency = 1 - transparency
                BottomDown.Transparency = 1 - transparency
                RightTop.Transparency = 1 - transparency
                RightSide.Transparency = 1 - transparency
                BottomRightSide.Transparency = 1 - transparency
                BottomRightDown.Transparency = 1 - transparency
                Chams.FillTransparency = 1 - transparency
                Chams.OutlineTransparency = 1 - transparency
                Outline.Transparency = 1 - transparency
            end

            Name.Visible = BorosConfig.Drawing.Names.Enabled
            Name.Text = plr.Name
            Name.Position = UDim2.new(0, pos.X, 0, pos.Y - h/2 - 9)

            Distance.Visible = BorosConfig.Drawing.Distances.Enabled
            Distance.Text = string.format("%d Studs", math.floor(dist))
            Distance.Position = UDim2.new(0, pos.X, 0, pos.Y + h/2 + (Weapon.Visible and 18 or 7))

            Weapon.Visible = BorosConfig.Drawing.Weapons.Enabled
            Weapon.Position = UDim2.new(0, pos.X, 0, pos.Y + h/2 + 7)

            Box.Position = UDim2.new(0, pos.X - w/2, 0, pos.Y - h/2)
            Box.Size = UDim2.new(0, w, 0, h)
            Box.Visible = BorosConfig.Drawing.Boxes.Full.Enabled

            if not BorosConfig.Drawing.Boxes.Bounding.Enabled or (BorosConfig.Drawing.Boxes.Corner.Enabled and BorosConfig.Drawing.Boxes.Bounding.Enabled) then
                LeftTop.Visible = BorosConfig.Drawing.Boxes.Corner.Enabled
                LeftTop.Position = UDim2.new(0, pos.X - w/2, 0, pos.Y - h/2)
                LeftTop.Size = UDim2.new(0, w/5, 0, 1)
                LeftSide.Visible = BorosConfig.Drawing.Boxes.Corner.Enabled
                LeftSide.Position = UDim2.new(0, pos.X - w/2, 0, pos.Y - h/2)
                LeftSide.Size = UDim2.new(0, 1, 0, h/5)
                BottomSide.Visible = BorosConfig.Drawing.Boxes.Corner.Enabled
                BottomSide.Position = UDim2.new(0, pos.X - w/2, 0, pos.Y + h/2)
                BottomSide.Size = UDim2.new(0, 1, 0, h/5)
                BottomDown.Visible = BorosConfig.Drawing.Boxes.Corner.Enabled
                BottomDown.Position = UDim2.new(0, pos.X - w/2, 0, pos.Y + h/2)
                BottomDown.Size = UDim2.new(0, w/5, 0, 1)
                RightTop.Visible = BorosConfig.Drawing.Boxes.Corner.Enabled
                RightTop.Position = UDim2.new(0, pos.X + w/2, 0, pos.Y - h/2)
                RightTop.Size = UDim2.new(0, w/5, 0, 1)
                RightSide.Visible = BorosConfig.Drawing.Boxes.Corner.Enabled
                RightSide.Position = UDim2.new(0, pos.X + w/2 - 1, 0, pos.Y - h/2)
                RightSide.Size = UDim2.new(0, 1, 0, h/5)
                BottomRightSide.Visible = BorosConfig.Drawing.Boxes.Corner.Enabled
                BottomRightSide.Position = UDim2.new(0, pos.X + w/2, 0, pos.Y + h/2)
                BottomRightSide.Size = UDim2.new(0, 1, 0, h/5)
                BottomRightDown.Visible = BorosConfig.Drawing.Boxes.Corner.Enabled
                BottomRightDown.Position = UDim2.new(0, pos.X + w/2, 0, pos.Y + h/2)
                BottomRightDown.Size = UDim2.new(0, w/5, 0, 1)
            end

            if not BorosConfig.Drawing.Boxes.Corner.Enabled then
                LeftTop.Visible = BorosConfig.Drawing.Boxes.Bounding.Enabled
                LeftTop.Position = UDim2.new(0, pos.X - w/2, 0, pos.Y - h/2)
                LeftTop.Size = UDim2.new(0, w, 0, 1)
                LeftSide.Visible = BorosConfig.Drawing.Boxes.Bounding.Enabled
                LeftSide.Position = UDim2.new(0, pos.X - w/2, 0, pos.Y - h/2)
                LeftSide.Size = UDim2.new(0, 1, 0, h)
                BottomSide.Visible = BorosConfig.Drawing.Boxes.Bounding.Enabled
                BottomSide.Position = UDim2.new(0, pos.X - w/2, 0, pos.Y + h/2)
                BottomSide.Size = UDim2.new(0, w, 0, 1)
                RightSide.Visible = BorosConfig.Drawing.Boxes.Bounding.Enabled
                RightSide.Position = UDim2.new(0, pos.X + w/2 - 1, 0, pos.Y - h/2)
                RightSide.Size = UDim2.new(0, 1, 0, h)
                BottomRightSide.Visible = false
                BottomRightDown.Visible = false
                BottomDown.Visible = false
                RightTop.Visible = false
            end

            if BorosConfig.Drawing.Healthbar.Enabled then
                local health_clamped = math.clamp(hum.Health, 0, hum.MaxHealth)
                local health = health_clamped / hum.MaxHealth
                Healthbar.Position = UDim2.new(0, pos.X - w/2 - 6, 0, pos.Y - h/2 + h * (1 - health))
                Healthbar.Size = UDim2.new(0, BorosConfig.Drawing.Healthbar.Width, 0, h * health)
                Healthbar.BackgroundTransparency = BorosConfig.Drawing.Healthbar.Transparency
                BehindHealthbar.Position = UDim2.new(0, pos.X - w/2 - 6, 0, pos.Y - h/2)
                BehindHealthbar.Size = UDim2.new(0, BorosConfig.Drawing.Healthbar.Width, 0, h)
                BehindHealthbar.BackgroundTransparency = BorosConfig.Drawing.Healthbar.Transparency
                Healthbar.Visible = true
                BehindHealthbar.Visible = true
                HealthText.Position = UDim2.new(0, pos.X - w/2 - 18, 0, pos.Y - h/2 + h * (1 - health) + 3)
            else
                Healthbar.Visible = false
                BehindHealthbar.Visible = false
                HealthText.Visible = false
            end

            Chams.Adornee = plr.Character
            Chams.Enabled = BorosConfig.Drawing.Chams.Enabled
            Outline.Enabled = BorosConfig.Drawing.Boxes.Gradient

            if BorosConfig.Drawing.Boxes.Animate then
                RotationAngle = RotationAngle + (tick() - TickTime) * BorosConfig.Drawing.Boxes.RotationSpeed * math.cos(math.pi / 4 * tick() - math.pi / 2)
                Gradient1.Rotation = RotationAngle
                Gradient2.Rotation = RotationAngle
            end
            TickTime = tick()

        else
            HideAllElements()
        end
    end)

    BorosPlayers[plr.Name] = {
        RefreshElements = RefreshElements,
        UpdateHealth = UpdateHealth,
        CharAddedConn = charAddedConn,
        RenderConn = renderConn,
        Container = container,
        Conns = borosConns,
    }
end

local function InitBorosESP()
    for _, plr in pairs(Players:GetPlayers()) do
        if plr ~= player then
            CreateBorosESP(plr)
        end
    end
end

local function RemoveBorosESP(plr)
    local data = BorosPlayers[plr.Name]
    if data then
        if data.RenderConn then
            data.RenderConn:Disconnect()
            data.RenderConn = nil
        end
        if data.CharAddedConn then
            data.CharAddedConn:Disconnect()
            data.CharAddedConn = nil
        end
        if data.Conns then
            if data.Conns.HealthChanged then data.Conns.HealthChanged:Disconnect() end
            if data.Conns.ChildAdded then data.Conns.ChildAdded:Disconnect() end
            if data.Conns.ChildRemoved then data.Conns.ChildRemoved:Disconnect() end
        end
        if data.Container then
            pcall(function() data.Container:Destroy() end)
            data.Container = nil
        end
        BorosPlayers[plr.Name] = nil
    end
    local container = BorosScreenGui:FindFirstChild(plr.Name)
    if container then
        pcall(function() container:Destroy() end)
    end
end

local function ToggleBorosESP(state)
    BorosConfig.Enabled = state
    BorosScreenGui.Enabled = state and espMasterEnabled
    if state and espMasterEnabled then
        RefreshAllBorosElements()
    else
        for name, data in pairs(BorosPlayers) do
            if data and data.Container then
                for _, child in ipairs(data.Container:GetChildren()) do
                    if child:IsA("TextLabel") or child:IsA("Frame") then
                        child.Visible = false
                    end
                end
            end
        end
    end
end

-- ============================================================
-- FUNÇÃO AUXILIAR PARA VERIFICAR INSTÂNCIA VÁLIDA
-- ============================================================
local function IsValidInstance(obj)
    if obj == nil then return false end
    if type(obj) ~= "userdata" and type(obj) ~= "Instance" then return false end
    local success, result = pcall(function()
        return obj.Parent
    end)
    if not success then return false end
    return result ~= nil
end

