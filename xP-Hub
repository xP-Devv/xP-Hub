local friendsGroup = AimbotTab:AddRightGroupbox("Players Friends", "users")
friendsGroup:AddLabel("Ative o toggle para ignorar o jogador")

local ignoredToggles = {}

local function rebuildIgnoredPlayersList()
    for _, toggle in ipairs(ignoredToggles) do
        if toggle and toggle.Destroy then
            pcall(function() toggle:Destroy() end)
        end
    end
    ignoredToggles = {}

    local players = Players:GetPlayers()
    for _, plr in ipairs(players) do
        if plr ~= player then
            local isIgnored = ignoredPlayers[plr.Name] or false
            local toggle = friendsGroup:AddToggle("IgnorePlayer_" .. plr.Name, {
                Text = plr.Name,
                Default = isIgnored,
                Callback = function(value)
                    if value then
                        ignoredPlayers[plr.Name] = true
                    else
                        ignoredPlayers[plr.Name] = nil
                    end
                end
            })
            table.insert(ignoredToggles, toggle)
        end
    end

    if #ignoredToggles == 0 then
        local label = friendsGroup:AddLabel("Nenhum outro jogador")
        table.insert(ignoredToggles, label)
    end
end

rebuildIgnoredPlayersList()

playerAddedConn = Players.PlayerAdded:Connect(function()
    task.wait(0.1)
    rebuildIgnoredPlayersList()
end)

playerRemovingConn = Players.PlayerRemoving:Connect(function(plr)
    if ignoredPlayers[plr.Name] then
        ignoredPlayers[plr.Name] = nil
    end
    task.wait(0.1)
    rebuildIgnoredPlayersList()
end)

