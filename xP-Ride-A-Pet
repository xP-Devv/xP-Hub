local singleFarmRunning = false

local function farmSingleEgg(eggName, button)
    if singleFarmRunning then
        if autoFarmStatusLabel then
            autoFarmStatusLabel.Text = "● Aguarde o farm atual terminar..."
            autoFarmStatusLabel.TextColor3 = Color3.fromRGB(255, 200, 0)
        end
        return
    end

    singleFarmRunning = true
    noclipSources.singleFarm = true
    refreshNoclip()

    if button then
        button.Text = "..."
        button.BackgroundColor3 = Color3.fromRGB(200, 130, 30)
    end

    if autoFarmStatusLabel then
        autoFarmStatusLabel.Text = "● Indo buscar: " .. eggName
        autoFarmStatusLabel.TextColor3 = Color3.fromRGB(0, 255, 120)
    end

    task.spawn(function()
        if hasEggInHand() then
            if autoFarmStatusLabel then
                autoFarmStatusLabel.Text = "● Voltando pra base com ovo na mão..."
                autoFarmStatusLabel.TextColor3 = Color3.fromRGB(0, 200, 255)
            end
            enableNoclip()
            bypassWalkToHome()
            _G.__CarryingEgg = false
            task.wait(0.3)
            if button then
                button.Text = "Auto Farm"
                button.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
            end
            singleFarmRunning = false
            noclipSources.singleFarm = false
            refreshNoclip()
            return
        end

        local target
        local list = collectEggs()
        for _, egg in ipairs(list) do
            if egg and egg.Parent and egg.Name == eggName and not isInClaimedBase(egg) then
                target = egg
                break
            end
        end

        if not target then
            if autoFarmStatusLabel then
                autoFarmStatusLabel.Text = "● Ovo não encontrado: " .. eggName
                autoFarmStatusLabel.TextColor3 = Color3.fromRGB(255, 100, 100)
            end
            if button then
                button.Text = "Auto Farm"
                button.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
            end
            singleFarmRunning = false
            noclipSources.singleFarm = false
            refreshNoclip()
            return
        end

        local ok = bypassMoveToTarget(target)
        if ok then
            task.wait(0.1)
            freezeCharacter()
            task.wait(0.15)

            if autoFarmStatusLabel then
                autoFarmStatusLabel.Text = "● Pegando: " .. eggName
                autoFarmStatusLabel.TextColor3 = Color3.fromRGB(0, 255, 120)
            end
            if target and target.Parent then
                holdEKey(2)
            end
            task.wait(0.2)

            _G.__CarryingEgg = true

            unfreezeCharacter()
            forceReleaseE()
            task.wait(0.1)

            if autoFarmStatusLabel then
                autoFarmStatusLabel.Text = "● Voltando pra base..."
                autoFarmStatusLabel.TextColor3 = Color3.fromRGB(0, 200, 255)
            end
            enableNoclip()
            bypassWalkToHome()
            _G.__CarryingEgg = false
            task.wait(0.3)

            if autoFarmStatusLabel then
                autoFarmStatusLabel.Text = "● Peguei: " .. eggName
                autoFarmStatusLabel.TextColor3 = Color3.fromRGB(0, 255, 120)
            end

            if button then
                button.Text = "✔ Feito"
                button.BackgroundColor3 = Color3.fromRGB(0, 150, 70)
                task.wait(1.5)
                if button and button.Parent then
                    button.Text = "Auto Farm"
                    button.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
                end
            end
        else
            if autoFarmStatusLabel then
                autoFarmStatusLabel.Text = "● Não consegui chegar no ovo"
                autoFarmStatusLabel.TextColor3 = Color3.fromRGB(255, 100, 100)
            end
            if button then
                button.Text = "Auto Farm"
                button.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
            end
        end

        singleFarmRunning = false
        noclipSources.singleFarm = false
        refreshNoclip()
    end)
end

-- =================== FLY ===================
local FLY_KEYBIND = Enum.KeyCode.F
local FLY_SPEED  = 50
local flying = false
local bodyVelocity, bodyGyro, currentHumanoid

local function getFlyMoveVector()
    local vec = Vector3.new(0, 0, 0)
    if UserInputService:IsKeyDown(Enum.KeyCode.W) then vec = vec + Vector3.new(0, 0, -1) end
    if UserInputService:IsKeyDown(Enum.KeyCode.S) then vec = vec + Vector3.new(0, 0, 1) end
    if UserInputService:IsKeyDown(Enum.KeyCode.A) then vec = vec + Vector3.new(-1, 0, 0) end
    if UserInputService:IsKeyDown(Enum.KeyCode.D) then vec = vec + Vector3.new(1, 0, 0) end
    if UserInputService:IsKeyDown(Enum.KeyCode.Space) then vec = vec + Vector3.new(0, 1, 0) end
    if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then vec = vec + Vector3.new(0, -1, 0) end
    return vec
end

local function startFly()
    if flying then return end
    local char = localPlayer.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    local hum  = char:FindFirstChildWhichIsA("Humanoid")
    if not root or not hum then return end

    flying = true
    currentHumanoid = hum
    hum.PlatformStand = true

    noclipSources.fly = true
    refreshNoclip()

    bodyGyro = Instance.new("BodyGyro")
    bodyGyro.P = 9e4
    bodyGyro.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
    bodyGyro.CFrame = root.CFrame
    bodyGyro.Parent = root

    bodyVelocity = Instance.new("BodyVelocity")
    bodyVelocity.Velocity = Vector3.new(0, 0, 0)
    bodyVelocity.MaxForce = Vector3.new(9e9, 9e9, 9e9)
    bodyVelocity.Parent = root

    hum.Died:Connect(function() flying = false end)

    task.spawn(function()
        while flying and root and root.Parent and hum and hum.Parent and not _G.__xPHub_Unloaded do
            local cam = workspace.CurrentCamera
            if cam and bodyVelocity and bodyGyro then
                local moveVec = getFlyMoveVector()
                local velocity = Vector3.new(0, 0, 0)
                if moveVec.Magnitude > 0 then
                    velocity = cam.CFrame:VectorToWorldSpace(moveVec.Unit) * FLY_SPEED
                end
                bodyVelocity.Velocity = velocity
                bodyGyro.CFrame = cam.CFrame
            end
            runService.RenderStepped:Wait()
        end
        if bodyVelocity then bodyVelocity:Destroy() bodyVelocity = nil end
        if bodyGyro then bodyGyro:Destroy() bodyGyro = nil end
        if currentHumanoid and currentHumanoid.Parent then
            pcall(function() currentHumanoid.PlatformStand = false end)
            pcall(function() currentHumanoid.AutoRotate = true end)
        end
    end)
end

local function stopFly()
    if not flying then return end
    flying = false
    noclipSources.fly = false
    refreshNoclip()

    if bodyVelocity then bodyVelocity:Destroy() bodyVelocity = nil end
    if bodyGyro then bodyGyro:Destroy() bodyGyro = nil end
    if currentHumanoid and currentHumanoid.Parent then
        pcall(function() currentHumanoid.PlatformStand = false end)
        pcall(function() currentHumanoid.AutoRotate = true end)
    end
end

