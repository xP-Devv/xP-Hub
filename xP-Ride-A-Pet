function Library:SelectTab(tabName)
    for _, tab in pairs(self.Tabs) do
        if tab.Name == tabName then
            for _, otherTab in pairs(self.Tabs) do
                otherTab.Button.BackgroundColor3 = Theme.TabsBG
                otherTab.Button.Font = Enum.Font.GothamSemibold
                otherTab.Page.Visible = false
            end
            tab.Button.BackgroundColor3 = Theme.Accent
            tab.Button.Font = Enum.Font.GothamBold
            tab.Page.Visible = true
            self.ActiveTab = tab
            return true
        end
    end
    return false
end

function Library:UpdateTheme(newColor)
    Theme.Accent = newColor
    Theme.ToggleOn = newColor
    Theme.SliderFill = newColor
    for _, tabBtn in pairs(CreatedElements.TabButtons) do
        if tabBtn.BackgroundColor3 ~= Theme.Sidebar and tabBtn.BackgroundColor3 ~= Theme.TabsBG then
            tabBtn.BackgroundColor3 = newColor
        end
    end
    for _, t in pairs(CreatedElements.Toggles) do if t.State then t.Btn.BackgroundColor3 = newColor end end
    for _, s in pairs(CreatedElements.Sliders) do s.Fill.BackgroundColor3 = newColor; s.ValueLabel.TextColor3 = newColor end
    for _, c in pairs(CreatedElements.Checkboxes) do if c.State then c.Box.BackgroundColor3 = newColor end end
    for _, k in pairs(CreatedElements.Keybinds) do k.Btn.TextColor3 = newColor end
    for _, a in pairs(CreatedElements.NotifAccentBars) do if a and a.Parent then a.BackgroundColor3 = newColor end end
end

