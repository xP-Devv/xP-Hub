    local function CreateToggle(parent, text, defaultState, callback, noNotify)
        local ToggleFrame = Create("Frame", {Size = UDim2.new(1, 0, 0, 38), BackgroundColor3 = Theme.ElementBG, Parent = parent}, {Create("UICorner", {CornerRadius = UDim.new(0, 6)})})
        Create("TextLabel", {Size = UDim2.new(1, -60, 1, 0), Position = UDim2.new(0, 12, 0, 0), BackgroundTransparency = 1, Text = text, TextColor3 = Theme.Text, Font = Enum.Font.GothamSemibold, TextSize = 13, TextXAlignment = Enum.TextXAlignment.Left, Parent = ToggleFrame})
        local ToggleBtn = Create("TextButton", {Size = UDim2.new(0, 36, 0, 18), Position = UDim2.new(1, -50, 0.5, -9), BackgroundColor3 = defaultState and Theme.ToggleOn or Theme.ToggleOff, Text = "", AutoButtonColor = false, Parent = ToggleFrame}, {Create("UICorner", {CornerRadius = UDim.new(1, 0)})})
        local Circle = Create("Frame", {Size = UDim2.new(0, 14, 0, 14), Position = defaultState and UDim2.new(1, -16, 0, 2) or UDim2.new(0, 2, 0, 2), BackgroundColor3 = Theme.Text, Parent = ToggleBtn}, {Create("UICorner", {CornerRadius = UDim.new(1, 0)})})
        local state = defaultState
        local toggleData = {Btn = ToggleBtn, State = state}
        table.insert(CreatedElements.Toggles, toggleData)

        local function setState(newState, fireCb)
            state = newState
            toggleData.State = newState
            Tween(ToggleBtn, 0.2, {BackgroundColor3 = state and Theme.ToggleOn or Theme.ToggleOff})
            Tween(Circle, 0.2, {Position = state and UDim2.new(1, -16, 0, 2) or UDim2.new(0, 2, 0, 2)})
            if fireCb and callback then callback(state) end
        end
        toggleData.SetState = setState

        ToggleBtn.MouseButton1Click:Connect(function()
            setState(not state, true)
            if not noNotify then NotifyToggle(text, state) end
        end)
        AddToSearch(ToggleFrame, text)
        return ToggleFrame
    end

    local function CreateSlider(parent, text, min, max, default, callback, noNotify)
        local SliderFrame = Create("Frame", {Size = UDim2.new(1, 0, 0, 48), BackgroundColor3 = Theme.ElementBG, Parent = parent}, {Create("UICorner", {CornerRadius = UDim.new(0, 6)})})
        Create("TextLabel", {Size = UDim2.new(1, -60, 0, 20), Position = UDim2.new(0, 12, 0, 4), BackgroundTransparency = 1, Text = text, TextColor3 = Theme.Text, Font = Enum.Font.GothamSemibold, TextSize = 13, TextXAlignment = Enum.TextXAlignment.Left, Parent = SliderFrame})
        local ValueLabel = Create("TextLabel", {Size = UDim2.new(0, 40, 0, 20), Position = UDim2.new(1, -50, 0, 4), BackgroundTransparency = 1, Text = tostring(default), TextColor3 = Theme.Accent, Font = Enum.Font.GothamBold, TextSize = 13, TextXAlignment = Enum.TextXAlignment.Right, Parent = SliderFrame})
        local SliderTrack = Create("Frame", {Size = UDim2.new(1, -24, 0, 4), Position = UDim2.new(0, 12, 0, 32), BackgroundColor3 = Theme.ToggleOff, Parent = SliderFrame}, {Create("UICorner", {CornerRadius = UDim.new(1, 0)})})
        local Fill = Create("Frame", {Size = UDim2.new((default - min) / (max - min), 0, 1, 0), BackgroundColor3 = Theme.SliderFill, Parent = SliderTrack}, {Create("UICorner", {CornerRadius = UDim.new(1, 0)})})
        local Knob = Create("Frame", {Size = UDim2.new(0, 12, 0, 12), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new((default - min) / (max - min), 0, 0.5, 0), BackgroundColor3 = Theme.Text, Parent = SliderTrack}, {Create("UICorner", {CornerRadius = UDim.new(1, 0)})})

        local sliderData = {Fill = Fill, ValueLabel = ValueLabel}
        table.insert(CreatedElements.Sliders, sliderData)

        local draggingSlider = false
        local val = default

        local function setValue(newVal, fireCb)
            newVal = math.clamp(math.floor(newVal), min, max)
            val = newVal
            local pos = (val - min) / (max - min)
            ValueLabel.Text = tostring(val)
            Tween(Fill, 0.1, {Size = UDim2.new(pos, 0, 1, 0)})
            Tween(Knob, 0.1, {Position = UDim2.new(pos, 0, 0.5, 0)})
            if fireCb and callback then callback(val) end
        end
        sliderData.SetValue = setValue

        local function UpdateSlider(input)
            local pos = math.clamp((input.Position.X - SliderTrack.AbsolutePosition.X) / SliderTrack.AbsoluteSize.X, 0, 1)
            val = math.floor((max - min) * pos + min)
            ValueLabel.Text = tostring(val)
            Tween(Fill, 0.1, {Size = UDim2.new(pos, 0, 1, 0)})
            Tween(Knob, 0.1, {Position = UDim2.new(pos, 0, 0.5, 0)})
            if callback then callback(val) end
        end

        SliderTrack.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 then draggingSlider = true; UpdateSlider(input) end
        end)
        UserInputService.InputChanged:Connect(function(input)
            if draggingSlider and input.UserInputType == Enum.UserInputType.MouseMovement then UpdateSlider(input) end
        end)
        UserInputService.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 and draggingSlider then
                draggingSlider = false
                if not noNotify then NotifySlider(text, val) end
            end
        end)
        AddToSearch(SliderFrame, text)
        return SliderFrame
    end

