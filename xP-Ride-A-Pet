-- =================== FUNÇÃO DE UNLOAD COMPLETO ===================
local function fullUnload()
    _G.__xPHub_Unloaded = true

    pcall(function() stopAutoFarm() end)
    pcall(function() stopFly() end)
    pcall(function() stopMovement() end)
    pcall(function() disableNoclip() end)
    pcall(function() unfreezeCharacter() end)
    pcall(function() forceReleaseE() end)

    pcall(function()
        if renderedEggsListener then renderedEggsListener:Disconnect() end
    end)

    pcall(function()
        if eggLoopThread then task.cancel(eggLoopThread) end
    end)

    pcall(clearAllESP)

    pcall(function()
        if _G.EggButtons then
            for _, b in pairs(_G.EggButtons) do
                if b and b.Parent then pcall(function() b:Destroy() end) end
            end
        end
        if _G.AutoFarmButtons then
            for _, b in pairs(_G.AutoFarmButtons) do
                if b and b.Parent then pcall(function() b:Destroy() end) end
            end
        end
    end)

    _G.EggESPFilters = nil
    _G.EggButtons = nil
    _G.AutoFarmButtons = nil
    _G.RarityFilters = nil
    _G.RarityCheckboxes = nil
    _G.__KeybindJustSet = nil
    _G.xP_UI_Library = nil
    _G.ESPEnabled = nil
    _G.__AutoFarmDirty = nil
    _G.__CarryingEgg = nil

    pcall(function()
        if xP_UI and xP_UI.ScreenGui then
            xP_UI.ScreenGui:Destroy()
        end
    end)
end

