    local function CreateKeybind(parent, text, defaultKey, callback)
        local KeyFrame = Create("Frame", {Size = UDim2.new(1, 0, 0, 38), BackgroundColor3 = Theme.ElementBG, Parent = parent}, {Create("UICorner", {CornerRadius = UDim.new(0, 6)})})
