local noclipSources = { fly = false, autoFarm = false, singleFarm = false }

local function enableNoclip()
    if noclipActive then return end
    local char = localPlayer.Character
    if not char then return end
    movementPartsState = {}
    for _, part in ipairs(char:GetDescendants()) do
        if part:IsA("BasePart") then
            movementPartsState[part] = part.CanCollide
            part.CanCollide = false
        end
    end
    noclipActive = true
end

local function disableNoclip()
    if not noclipActive then return end
    if movementPartsState then
        for part, oldVal in pairs(movementPartsState) do
            if part and part.Parent then part.CanCollide = oldVal end
        end
        movementPartsState = nil
    end
    noclipActive = false
end

local function refreshNoclip()
    if noclipSources.fly or noclipSources.autoFarm or noclipSources.singleFarm then
        enableNoclip()
    else
        disableNoclip()
    end
end

