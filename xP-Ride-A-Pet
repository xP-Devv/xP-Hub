local BYPASS_STEP_STUDS = 8
local BYPASS_MIN_WAIT = 0.015

local function bypassMoveToTarget(target)
    if movementActive then return false end
    local char = localPlayer.Character
    local root = getRootPart()
    local humanoid = char and char:FindFirstChildOfClass("Humanoid")
    local targetCFrame = getTargetCFrame(target)
    if not root or not humanoid or not targetCFrame then return false end

    local destination = targetCFrame.Position + Vector3.new(0, TP_HEIGHT, 0)
    local startPos = root.Position
    local offset = destination - startPos
    local totalDistance = offset.Magnitude

    if totalDistance <= 2 then
        root.CFrame = targetCFrame * CFrame.new(0, TP_HEIGHT, 0)
        return true
    end

    movementActive = true
    movementHumanoid = humanoid
    local oldAutoRotate = humanoid.AutoRotate
    local success = false

    enableNoclip()
    humanoid.AutoRotate = false

    local steps = math.max(2, math.ceil(totalDistance / BYPASS_STEP_STUDS))
    local direction = offset / totalDistance
    local stepVector = offset / steps

    local startTime = os.clock()
    local maxTime = math.max(5, totalDistance / 100 + 4)

    local ok, err = pcall(function()
        for i = 1, steps do
            if not movementActive then break end
            if not target or not target.Parent then break end
            if getRootPart() ~= root then break end
            if os.clock() - startTime > maxTime then break end

            if i % 5 == 0 then
                enableNoclip()
            end

            local newPos = startPos + stepVector * i
            root.CFrame = CFrame.new(newPos, newPos + direction)
            runService.Heartbeat:Wait()
            task.wait(BYPASS_MIN_WAIT)
        end

        if target and target.Parent and getRootPart() == root then
            root.CFrame = targetCFrame * CFrame.new(0, TP_HEIGHT, 0)
            success = true
        end
    end)

    movementActive = false
    movementHumanoid = nil
    if humanoid and humanoid.Parent then
        pcall(function() humanoid.AutoRotate = oldAutoRotate end)
    end
    refreshNoclip()

    if not ok then
        warn("[xP Hub] bypassMoveToTarget erro:", err)
    end
    return success
end

local moveToTarget = bypassMoveToTarget

