local function getAutoFarmEggs()
    local list = collectEggs()
    local filtered = {}
    for _, egg in ipairs(list) do
        local rarity = getEggInfo(egg.Name)
        if selectedRarities[rarity]
           and not autoFarmProcessed[egg]
           and not isInClaimedBase(egg) then
            table.insert(filtered, egg)
        end
    end
    sortEggsByPriority(filtered)
    return filtered
end

-- 👇 FIX: stopAutoFarm força AutoRotate = true SEMPRE
local function stopAutoFarm()
    autoFarmActive = false

    if autoFarmThread then
        task.cancel(autoFarmThread)
        autoFarmThread = nil
    end

    pcall(stopMovement)
    movementActive = false
    movementHumanoid = nil

    pcall(unfreezeCharacter)
    pcall(forceReleaseE)

    -- Força AutoRotate no personagem atual
    local char = localPlayer.Character
    if char then
        local hum = char:FindFirstChildWhichIsA("Humanoid")
        if hum then
            pcall(function() hum.AutoRotate = true end)
        end
    end

    noclipSources.autoFarm = false
    refreshNoclip()
end

local renderedEggsListener = nil
local function attachRenderedEggsListener()
    if renderedEggsListener then renderedEggsListener:Disconnect() end
    local renderedFolder = workspace:FindFirstChild("RenderedEggs")
    if not renderedFolder then
        task.spawn(function()
            renderedFolder = workspace:WaitForChild("RenderedEggs", 30)
            if renderedFolder and not _G.__xPHub_Unloaded then
                renderedEggsListener = renderedFolder.ChildAdded:Connect(function()
                    if autoFarmActive then
                        _G.__AutoFarmDirty = true
                    end
                end)
            end
        end)
    else
        renderedEggsListener = renderedFolder.ChildAdded:Connect(function()
            if autoFarmActive then
                _G.__AutoFarmDirty = true
            end
        end)
    end
end

local function startAutoFarm()
    stopAutoFarm()
    task.wait(0.2)

    movementActive = false
    movementHumanoid = nil
    pcall(unfreezeCharacter)
    pcall(forceReleaseE)

    autoFarmActive = true
    noclipSources.autoFarm = true
    refreshNoclip()

    attachRenderedEggsListener()

    autoFarmThread = task.spawn(function()
        if hasEggInHand() then
            if autoFarmStatusLabel then
                autoFarmStatusLabel.Text = "● Voltando pra base (ovo na mão)..."
                autoFarmStatusLabel.TextColor3 = Color3.fromRGB(0, 200, 255)
            end
            enableNoclip()
            bypassWalkToHome()
            _G.__CarryingEgg = false
            task.wait(0.3)
        end

        while autoFarmActive and not _G.__xPHub_Unloaded do
            _G.__AutoFarmDirty = false

            if hasEggInHand() then
                if autoFarmStatusLabel then
                    autoFarmStatusLabel.Text = "● Voltando pra base (ovo na mão)..."
                    autoFarmStatusLabel.TextColor3 = Color3.fromRGB(0, 200, 255)
                end
                enableNoclip()
                bypassWalkToHome()
                _G.__CarryingEgg = false
                task.wait(0.3)
            end

            if not noclipActive then enableNoclip() end
            if getRootPart() and getRootPart().Anchored then
                unfreezeCharacter()
            end

            -- 👇 FIX: Garante AutoRotate true quando não está se movendo
            local humCheck = localPlayer.Character and localPlayer.Character:FindFirstChildWhichIsA("Humanoid")
            if humCheck and humCheck.AutoRotate == false and not movementActive then
                pcall(function() humCheck.AutoRotate = true end)
            end

            local eggs = getAutoFarmEggs()
            if #eggs == 0 then
                if autoFarmStatusLabel then
                    autoFarmStatusLabel.Text = "● Aguardando novos ovos spawnarem..."
                    autoFarmStatusLabel.TextColor3 = Color3.fromRGB(255, 200, 0)
                end
                local waited = 0
                while autoFarmActive and not _G.__AutoFarmDirty and waited < 1 do
                    task.wait(0.1)
                    waited = waited + 0.1
                end
            else
                local didWork = false
                for _, egg in ipairs(eggs) do
                    if not autoFarmActive then break end
                    if egg and egg.Parent and not autoFarmProcessed[egg] then
                        didWork = true
                        local rarityEgg, luckEgg = getEggInfo(egg.Name)
                        if autoFarmStatusLabel then
                            autoFarmStatusLabel.Text = string.format("● Farmando: %s [%s] 🍀 %s", egg.Name, rarityEgg, luckEgg)
                            autoFarmStatusLabel.TextColor3 = Color3.fromRGB(0, 255, 120)
                        end

                        if not autoFarmActive then break end
                        enableNoclip()

                        local root = getRootPart()
                        local eggCFrame = getTargetCFrame(egg)
                        local moved = false
                        if root and eggCFrame then
                            local dist = (root.Position - eggCFrame.Position).Magnitude
                            if dist <= 10 then
                                root.CFrame = eggCFrame * CFrame.new(0, TP_HEIGHT, 0)
                                moved = true
                            end
                        end

                        if not moved then
                            moved = bypassMoveToTarget(egg)
                        end

                        if moved and autoFarmActive then
                            task.wait(0.1)
                            freezeCharacter()
                            task.wait(0.15)

                            if autoFarmActive and egg and egg.Parent then
                                holdEKey(2)
                            end
                            task.wait(0.2)

                            _G.__CarryingEgg = true

                            unfreezeCharacter()
                            forceReleaseE()
                            task.wait(0.1)
                        end

                        pcall(unfreezeCharacter)
                        pcall(forceReleaseE)
                        task.wait(0.05)

                        if autoFarmActive then
                            enableNoclip()
                            bypassWalkToHome()
                            _G.__CarryingEgg = false
                        end
                        autoFarmProcessed[egg] = true
                        task.wait(0.15)
                    end
                end
                if not didWork then
                    task.wait(0.3)
                end
            end
        end
        VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.E, false, game)
    end)
end

