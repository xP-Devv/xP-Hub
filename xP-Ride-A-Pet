        table.insert(CreatedElements.Keybinds, {Btn = KeyBtn})
        local currentKey = defaultKey
        local listening = false
        KeyBtn.MouseButton1Click:Connect(function()
            listening = true; KeyBtn.Text = "[...]"; KeyBtn.TextColor3 = Theme.TextDim
