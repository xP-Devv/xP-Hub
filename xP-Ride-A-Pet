-- =================== IGNORA OVOS EM BASE COM DONO REAL ===================
local function isInClaimedBase(egg)
    local current = egg
    while current and current ~= workspace do
        local dataFolder = current:FindFirstChild("Data")
        if dataFolder then
            local ownerValue = dataFolder:FindFirstChild("Owner")
            if ownerValue then
                local hasOwner = false
                if ownerValue:IsA("StringValue") then
                    hasOwner = ownerValue.Value ~= nil and ownerValue.Value ~= ""
                elseif ownerValue:IsA("ObjectValue") then
                    hasOwner = ownerValue.Value ~= nil
                else
                    local v = ownerValue.Value
                    hasOwner = v ~= nil and tostring(v) ~= "" and tostring(v) ~= "0"
                end
                if hasOwner then return true end
            end
        end
        current = current.Parent
    end
    return false
end

-- =================== COLETA OVOS SEM DUPLICAR ===================
local function collectEggs()
    local eggs, seenSet = {}, {}
    local function markAndAdd(obj)
        if seenSet[obj] then return end
        seenSet[obj] = true
        for _, d in ipairs(obj:GetDescendants()) do seenSet[d] = true end
        table.insert(eggs, obj)
    end
    local renderedFolder = workspace:FindFirstChild("RenderedEggs")
    if renderedFolder then
        for _, c in ipairs(renderedFolder:GetChildren()) do
            if c:IsA("Model") or c:IsA("BasePart") then markAndAdd(c) end
        end
    end
    for _, item in ipairs(workspace:GetDescendants()) do
        if not seenSet[item] and (item:IsA("Model") or item:IsA("BasePart")) and string.find(string.lower(item.Name), "egg", 1, true) then
            local hasEggAncestor = false
            local p = item.Parent
            while p and p ~= workspace do
                if seenSet[p] then hasEggAncestor = true break end
                p = p.Parent
            end
            if not hasEggAncestor then markAndAdd(item) end
        end
    end
    return eggs
end

