        if old then old:Destroy() end
        return
    end
    if _G.RarityFilters[rarity] == false or _G.EggESPFilters[object.Name] == false then
        local old = object:FindFirstChild("RarityTextESP")
        if old then old:Destroy() end
        return
    end
    if object:FindFirstChild("RarityTextESP") then return end

    local targetPart = object:IsA("BasePart") and object or object:FindFirstChildWhichIsA("BasePart", true)
    if not targetPart then return end

    local billboard = Instance.new("BillboardGui")
    billboard.Name = "RarityTextESP"
    billboard.Size = UDim2.new(0, 280, 0, 90)
    billboard.AlwaysOnTop = true
    billboard.MaxDistance = 6000
    billboard.StudsOffset = Vector3.new(0, 3, 0)

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, 0, 1, 0)
    label.BackgroundTransparency = 1
    label.TextColor3 = RARITY_COLORS[rarity] or RARITY_COLORS["Default"]
    label.TextSize = 20
    label.Font = Enum.Font.SourceSansBold
    label.TextStrokeTransparency = 0
    label.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
    label.Parent = billboard

    billboard.Adornee = targetPart
    billboard.Parent = object

    task.spawn(function()
        while billboard and billboard.Parent and label.Parent
              and object and object.Parent
              and not _G.__xPHub_Unloaded
              and _G.ESPEnabled
              and not isInClaimedBase(object)
              and _G.RarityFilters[rarity] ~= false
              and _G.EggESPFilters[object.Name] ~= false do
            local root = localPlayer.Character and localPlayer.Character:FindFirstChild("HumanoidRootPart")
            if root and targetPart.Parent then
                local d = math.floor((root.Position - targetPart.Position).Magnitude)
                label.Text = string.format("%s\n[%s] [🍀 %s]\n[%d m]", object.Name, rarity, luck, d)
            else
                label.Text = string.format("%s\n[%s] [🍀 %s]", object.Name, rarity, luck)
            end
            task.wait(0.2)
        end
        if billboard then billboard:Destroy() end
    end)
end

