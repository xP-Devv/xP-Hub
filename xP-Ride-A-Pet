        local SearchFrame = Create("Frame", {Size = UDim2.new(1, 0, 0, 38), BackgroundColor3 = Theme.SearchBG, BorderSizePixel = 0, Parent = Tab.Page}, {
            Create("UICorner", {CornerRadius = UDim.new(0, 8)}),
