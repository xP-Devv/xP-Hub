        applyRarityTextESP(egg, rarity, luck)

        if not isInClaimedBase(egg) then
            local part = egg:IsA("BasePart") and egg or egg:FindFirstChildWhichIsA("BasePart", true)
            local dist = 0
            if root and part then
                dist = math.floor((root.Position - part.Position).Magnitude)
            end

            if not unique[egg.Name] then
                if _G.EggESPFilters[egg.Name] == nil then _G.EggESPFilters[egg.Name] = true end
                unique[egg.Name] = {dist=dist, rar=rarity, lk=luck}
            else
                if dist > 0 and dist < unique[egg.Name].dist then
                    unique[egg.Name].dist = dist
                end
            end
        end
    end

    local sorted = {}
    for eggName, data in pairs(unique) do
        table.insert(sorted, {name=eggName, data=data})
    end
    sortEggsByPriority(sorted)

    for _, entry in ipairs(sorted) do
        local eggName = entry.name
        local data    = entry.data

        local btn = _G.EggButtons[eggName]
        if not btn or not btn.Parent then
            btn = Instance.new("TextButton")
            btn.Size = UDim2.new(1, -10, 0, 44)
            btn.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
            btn.Font = Enum.Font.GothamSemibold
            btn.TextSize = 13
            btn.Text = ""
            btn.TextXAlignment = Enum.TextXAlignment.Left
            btn.AutoButtonColor = false
            btn.Parent = EggScroll
            Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)
            _G.EggButtons[eggName] = btn

            local icon = Instance.new("ImageLabel")
            icon.Name = "EggIcon"
            icon.Size = UDim2.new(0, 36, 0, 36)
            icon.Position = UDim2.new(0, 4, 0.5, -18)
            icon.BackgroundTransparency = 1
            icon.Image = getEggImage(eggName)
            icon.ScaleType = Enum.ScaleType.Fit
            icon.Parent = btn

            local text = Instance.new("TextLabel")
            text.Name = "EggText"
            text.Size = UDim2.new(1, -48, 1, 0)
            text.Position = UDim2.new(0, 46, 0, 0)
            text.BackgroundTransparency = 1
            text.Text = ""
            text.TextXAlignment = Enum.TextXAlignment.Left
            text.Font = Enum.Font.GothamSemibold
            text.TextSize = 12
            text.Parent = btn

            btn.MouseButton1Click:Connect(function()
                if not _G.ESPEnabled then return end
                local rar = getEggInfo(eggName)
                if _G.RarityFilters[rar] ~= false then
                    _G.EggESPFilters[eggName] = not _G.EggESPFilters[eggName]
                    pcall(updateEggMenu)
                end
            end)
        end

        local isOn    = _G.EggESPFilters[eggName]
        local isRarOn = _G.RarityFilters[data.rar]

        local icon  = btn:FindFirstChild("EggIcon")
        local text  = btn:FindFirstChild("EggText")

        if icon then
            local img = getEggImage(eggName)
            if img ~= "" and icon.Image ~= img then
                icon.Image = img
            end
        end

        local distStr = string.format("[%d m]", data.dist)

        if not _G.ESPEnabled then
            btn.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
            if text then
                text.Text = string.format("💤 %s (ESP OFF)", eggName)
                text.TextColor3 = Color3.fromRGB(90, 90, 90)
            end
        elseif not isRarOn then
            btn.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
            if text then
                text.Text = string.format("💤 %s (RARIDADE OFF)", eggName)
                text.TextColor3 = Color3.fromRGB(90, 90, 90)
            end
        elseif isOn then
            btn.BackgroundColor3 = Color3.fromRGB(35, 45, 35)
            if text then
                text.Text = string.format("%s\n[%s] 🍀 %s  %s", eggName, data.rar, data.lk, distStr)
                text.TextColor3 = RARITY_COLORS[data.rar] or RARITY_COLORS["Default"]
            end
        else
            btn.BackgroundColor3 = Color3.fromRGB(45, 30, 30)
            if text then
                text.Text = string.format("❌ %s\n[%s]  %s", eggName, data.rar, distStr)
                text.TextColor3 = Color3.fromRGB(150, 150, 150)
            end
        end
    end

    local activeNames = {}
    for _, entry in ipairs(sorted) do
        activeNames[entry.name] = true
    end
    for name, btn in pairs(_G.EggButtons) do
        if not activeNames[name] and btn.Parent then
            btn:Destroy()
            _G.EggButtons[name] = nil
        end
    end
end

