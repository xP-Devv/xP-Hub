local function getEggInfo(name)
    local lower = string.lower(name)
    for rawName, info in pairs(EGG_DATABASE) do
        if string.find(lower, string.lower(rawName), 1, true) then
            return info.rarity, info.luck
        end
    end
    if string.find(lower, "divine") then return "Divine", "???" end
    if string.find(lower, "ethereal") or string.find(lower, "etheral") then return "Ethereal", "???" end
    if string.find(lower, "mythic") then return "Mythic", "90,000+" end
    if string.find(lower, "legendary") then return "Legendary", "???" end
    if string.find(lower, "epic") then return "Epic", "???" end
    if string.find(lower, "rare") then return "Rare", "???" end
    return "Common", "1"
end

local function parseLuck(luckStr)
    if not luckStr then return 0 end
    if luckStr == "???" or luckStr == "90,000+" then return 0 end
    local cleaned = tostring(luckStr):gsub(",", ""):gsub("%+", "")
    return tonumber(cleaned) or 0
end

local function sortEggsByPriority(list)
    table.sort(list, function(a, b)
        local nameA = a.Name or a.name
        local nameB = b.Name or b.name
        local rarA, lkA = getEggInfo(nameA)
        local rarB, lkB = getEggInfo(nameB)
        local wa = RARITY_WEIGHT[rarA] or 99
        local wb = RARITY_WEIGHT[rarB] or 99
        if wa ~= wb then return wa < wb end
        local na = parseLuck(lkA)
        local nb = parseLuck(lkB)
        if na ~= nb then return na > nb end
        return nameA:lower() < nameB:lower()
    end)
end

