function Library:Notify(title, text, duration)
    if not NotificationsEnabled then return end
    if not NotifContainer then return end
    duration = duration or 4

    local Notif = Create("Frame", {
        Size = UDim2.new(0, 280, 0, 60),
        Position = UDim2.new(1, 320, 0, 0),
        BackgroundColor3 = Color3.fromRGB(20, 20, 20),
        BorderSizePixel = 0,
        ClipsDescendants = false,
        Parent = NotifContainer
    }, {
        Create("UICorner", {CornerRadius = UDim.new(0, 6)}),
        Create("UIStroke", {Color = Color3.fromRGB(45, 45, 45), Thickness = 1, ApplyStrokeMode = Enum.ApplyStrokeMode.Border})
    })

    local ClickBtn = Create("TextButton", {Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1, Text = "", AutoButtonColor = false, ZIndex = 5, Parent = Notif})
    local AccentBar = Create("Frame", {Size = UDim2.new(0, 4, 1, 0), BackgroundColor3 = Theme.Accent, BorderSizePixel = 0, Parent = Notif}, {Create("UICorner", {CornerRadius = UDim.new(0, 6)})})
    table.insert(CreatedElements.NotifAccentBars, AccentBar)

    Create("TextLabel", {Size = UDim2.new(1, -25, 0, 20), Position = UDim2.new(0, 15, 0, 8), BackgroundTransparency = 1, Text = title, TextColor3 = Color3.fromRGB(255,255,255), Font = Enum.Font.GothamBold, TextSize = 13, TextXAlignment = Enum.TextXAlignment.Left, Parent = Notif})
    Create("TextLabel", {Size = UDim2.new(1, -25, 0, 22), Position = UDim2.new(0, 15, 0, 28), BackgroundTransparency = 1, Text = text, TextColor3 = Color3.fromRGB(180,180,180), Font = Enum.Font.Gotham, TextSize = 11, TextXAlignment = Enum.TextXAlignment.Left, TextWrapped = true, Parent = Notif})

    local isClosing = false
    local function closeNotif()
        if isClosing then return end
        isClosing = true
        for i, n in ipairs(CreatedElements.Notifications) do
            if n == Notif then table.remove(CreatedElements.Notifications, i); break end
        end
        Tween(Notif, 0.35, {Position = UDim2.new(1, 320, 0, Notif.Position.Y.Offset), BackgroundTransparency = 1})
        for _, child in pairs(Notif:GetDescendants()) do
            if child:IsA("TextLabel") then Tween(child, 0.35, {TextTransparency = 1})
            elseif child:IsA("Frame") and child ~= Notif then Tween(child, 0.35, {BackgroundTransparency = 1})
            elseif child:IsA("UIStroke") then Tween(child, 0.35, {Transparency = 1}) end
        end
        task.wait(0.4)
        if Notif and Notif.Parent then Notif:Destroy() end
    end

    ClickBtn.MouseButton1Click:Connect(closeNotif)
    ClickBtn.MouseEnter:Connect(function() Tween(Notif, 0.2, {BackgroundColor3 = Color3.fromRGB(30,30,30)}) end)
    ClickBtn.MouseLeave:Connect(function() Tween(Notif, 0.2, {BackgroundColor3 = Color3.fromRGB(20,20,20)}) end)
    Tween(Notif, 0.4, {Position = UDim2.new(1, -295, 0, 0)})
    table.insert(CreatedElements.Notifications, Notif)
    task.delay(duration, function() closeNotif() end)
end

