-- Kill Aura SEM DASH
local function sendKillAura()
    if not Features.KillAura.enabled then return end
    local cfg = Features.KillAura.config

    local character = LocalPlayer.Character
    if not character then return end
    local hrp = character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    local charName = getCurrentCharacter()
    if not charName then return end

    local wallCombo = ReplicatedStorage:FindFirstChild("Characters")
        and ReplicatedStorage.Characters:FindFirstChild(charName)
        and ReplicatedStorage.Characters[charName]:FindFirstChild("WallCombo")
    if not wallCombo then return end

    local abilityRemote = ReplicatedStorage:FindFirstChild("Remotes")
        and ReplicatedStorage.Remotes:FindFirstChild("Abilities")
        and ReplicatedStorage.Remotes.Abilities:FindFirstChild("Ability")
    local combatRemote = ReplicatedStorage:FindFirstChild("Remotes")
        and ReplicatedStorage.Remotes:FindFirstChild("Combat")
        and ReplicatedStorage.Remotes.Combat:FindFirstChild("Action")
    if not abilityRemote or not combatRemote then return end

    local FIXED_DAMAGE = 1
    local maxDist = tonumber(cfg.MaxDistance) or 100

    for _, targetPlayer in ipairs(Players:GetPlayers()) do
        if targetPlayer == LocalPlayer then continue end
        if not targetPlayer.Character then continue end

        local targetHRP = targetPlayer.Character:FindFirstChild("HumanoidRootPart")
        local targetHumanoid = targetPlayer.Character:FindFirstChild("Humanoid")
        if not targetHRP or not targetHumanoid then continue end
        if targetHumanoid.Health <= 0 then continue end
        if cfg.IgnoreFriends and LocalPlayer:IsFriendsWith(targetPlayer.UserId) then continue end
        if (hrp.Position - targetHRP.Position).Magnitude > maxDist then continue end

        pcall(function()
            abilityRemote:FireServer(wallCombo, FIXED_DAMAGE, {}, targetHRP.Position)
        end)

        local combatArgs = {
            wallCombo, charName .. ":WallCombo", 2, FIXED_DAMAGE,
            {
                HitboxCFrames = { targetHRP.CFrame, targetHRP.CFrame },
                BestHitCharacter = targetPlayer.Character,
                HitCharacters = { targetPlayer.Character },
                Ignore = {}, DeathInfo = {}, BlockedCharacters = {},
                HitInfo = { IsFacing = false, IsInFront = true },
                ServerTime = os.time(),
                Actions = {
                    ActionNumber1 = {
                        [targetPlayer.Name] = {
                            StartCFrameStr = tostring(hrp.CFrame),
                            Local = true, Collision = false,
                            Animation = "Punch1Hit", Preset = "Punch",
                            Velocity = Vector3.zero,
                            FromPosition = targetHRP.Position,
                            Seed = math.random(1, 999999)
                        }
                    }
                },
                FromCFrame = targetHRP.CFrame
            },
            "Action150", 0
        }
        pcall(function() combatRemote:FireServer(unpack(combatArgs)) end)
    end
end

local function tpwalkUpdate()
    if not Features.TPWalk.enabled then return end
    local char = LocalPlayer.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local humanoid = char:FindFirstChild("Humanoid")
    if not hrp or not humanoid then return end
    if humanoid.MoveDirection.Magnitude > 0 then
        hrp.CFrame = hrp.CFrame + (humanoid.MoveDirection * Features.TPWalk.config.Speed)
    end
end

-- ============================================================
-- X-RAY
-- ============================================================
local function isCharacterPart(v)
    local char = LocalPlayer.Character
    if not char then return false end
    return v:IsDescendantOf(char)
end

local function applyXRay()
    local t = Features.XRay.enabled and Features.XRay.config.transparency or 0
    for _, v in pairs(workspace:GetDescendants()) do
        if v:IsA("BasePart") and not isCharacterPart(v) then
            v.LocalTransparencyModifier = t
        end
    end
end

local function onNewPart(part)
    if not part:IsA("BasePart") then return end
    if not isCharacterPart(part) then
        part.LocalTransparencyModifier = Features.XRay.enabled and Features.XRay.config.transparency or 0
    end
end

local function startXRay()
    if xrayConnection then xrayConnection:Disconnect() end
    applyXRay()
    xrayConnection = workspace.DescendantAdded:Connect(onNewPart)
end

local function stopXRay()
    if xrayConnection then xrayConnection:Disconnect(); xrayConnection = nil end
    for _, v in pairs(workspace:GetDescendants()) do
        if v:IsA("BasePart") and not isCharacterPart(v) then
            v.LocalTransparencyModifier = 0
        end
    end
end

