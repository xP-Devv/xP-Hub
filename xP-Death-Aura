-- ============ UNLOAD SCRIPT (dentro do Menu) ============
local function fullUnload()
    sendNotification("xP Hub", "Descarregando script...")

    for _, key in ipairs({
        "KillAura","TPWalk","XRay","Invisible","NoCooldown","NoStun",
        "InfiniteUltimate","NoSlowdowns","NoJumpFatigue","MultiUseCutscenes",
        "Endless","DisableCombatTimer"
    }) do
        if Features[key] then Features[key].enabled = false end
    end

    pcall(function() if killAuraConn then killAuraConn:Disconnect() end end)
    pcall(function() if tpwalkConn then tpwalkConn:Disconnect() end end)
    pcall(function() if xrayConnection then xrayConnection:Disconnect() end end)
    pcall(function() if KillAuraRing.conn then KillAuraRing.conn:Disconnect() end end)
    killAuraConn, tpwalkConn, xrayConnection = nil, nil, nil

    pcall(restoreHitbox)

    pcall(function()
        for _, v in pairs(workspace:GetDescendants()) do
            if v:IsA("BasePart") then
                v.LocalTransparencyModifier = 0
            end
        end
    end)

    pcall(restoreAllGameSettings)
    pcall(function() getgenv().InvisibleBlock = false end)

    pcall(destroyCirclePart)
    pcall(destroyKillAuraRing)
    pcall(function()
        local p = workspace:FindFirstChild("SpawnPlacePlatform")
        if p then p:Destroy() end
    end)
    pcall(function()
        local a = workspace:FindFirstChild("HitboxVisualizer_xPHub")
        if a then a:Destroy() end
    end)
    pcall(function()
        local b = workspace:FindFirstChild("KillAuraRing_xPHub")
        if b then b:Destroy() end
    end)

    task.wait(0.3)
    pcall(function()
        game.StarterGui:SetCore("SendNotification", {
            Title = "xP Hub", Text = "Script descarregado!", Duration = 3
        })
    end)
    task.wait(0.5)

    pcall(function() Library:Unload() end)
end

menuGroup:AddDivider()

menuGroup:AddButton({
    Text = "Unload Script",
    Func = fullUnload,
    DoubleClick = false,
    Risky = true,
    Tooltip = "Descarrega TODO o script e restaura as configs originais",
})

