-- INVISIBLE
-- ============================================================
local Invisible = {
    remote = nil,
    hooked = false,
    originalCF = nil,
}

local function hookReplicationRemote(remote)
    if Invisible.hooked then return end
    Invisible.hooked = true
    Invisible.remote = remote

    local mt = getrawmetatable(game)
    local oldNamecall = mt.__namecall
    setreadonly(mt, false)
    mt.__namecall = newcclosure(function(self, ...)
        if getnamecallmethod() == "FireServer"
            and self == Invisible.remote
            and getgenv().InvisibleBlock then
            return nil
        end
        return oldNamecall(self, ...)
    end)
    setreadonly(mt, true)
end

local function toggleInvisible()
    Features.Invisible.enabled = not Features.Invisible.enabled

    if Features.Invisible.enabled then
        local char = LocalPlayer.Character
        if not char then
            sendNotification("Invisible", "Sem personagem!")
            Features.Invisible.enabled = false
            return
        end
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if not hrp then
            Features.Invisible.enabled = false
            return
        end

        local Remote = ReplicatedStorage:FindFirstChild("Remotes")
            and ReplicatedStorage.Remotes:FindFirstChild("Replication")
            and ReplicatedStorage.Remotes.Replication:FindFirstChild("FullCustomReplicationUnreliable")
        if not Remote then
            sendNotification("Invisible", "Remote não encontrado!")
            Features.Invisible.enabled = false
            return
        end

        hookReplicationRemote(Remote)

        Invisible.originalCF = hrp.CFrame
        local flyingCF = Invisible.originalCF + Vector3.new(0, 50000, 0)

        task.spawn(function()
            for i = 1, 10 do
                if hrp and hrp.Parent then
                    hrp.CFrame = flyingCF
                end
                pcall(function() Remote:FireServer() end)
                task.wait(0.1)
            end
            getgenv().InvisibleBlock = true
            if hrp and hrp.Parent and Invisible.originalCF then
                hrp.CFrame = Invisible.originalCF
            end
            sendNotification("Invisible", "Ativado!")
        end)
    else
        getgenv().InvisibleBlock = false
        sendNotification("Invisible", "Desativado!")
    end
end

