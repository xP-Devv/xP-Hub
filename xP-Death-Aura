local function hookValidation(funcName)
    for _, v in pairs(getgc(true)) do
        if typeof(v) == "function" and debug.getinfo(v).name == funcName then
            pcall(function()
                hookfunction(v, function(...) return true end)
            end)
            return true
        end
    end
    return false
end

local BypassList = {
    { key = "Movement",   name = "Movement",   funcName = "validateMovement" },
    { key = "Velocity",   name = "Velocity",   funcName = "validateVelocity" },
