-- ============================================================
-- BYPASS SEGURO (Anti-Kick / Anti-Ban)
-- ============================================================
do
    local _pcall = pcall
    local _setreadonly = setreadonly
    local _newcclosure = newcclosure or function(f) return f end

    _pcall(function()
        local mt = (getrawmetatable and getrawmetatable(game)) or getmetatable(game)
        if not mt then return end
        local oldNamecall = mt.__namecall
        if not oldNamecall then return end
        if _setreadonly then _setreadonly(mt, false) end
        mt.__namecall = _newcclosure(function(self, ...)
            local method = getnamecallmethod()
            if method == "Kick" or method == "Ban" then
                if self == Player or self == game then return nil end
            end
            return oldNamecall(self, ...)
        end)
        if _setreadonly then _setreadonly(mt, true) end
    end)

    _pcall(function()
        if hookfunction then
            local oldKick = Player.Kick
            hookfunction(oldKick, _newcclosure(function(self, ...)
                if self == Player then return nil end
                return oldKick(self, ...)
            end))
        end
    end)
end

