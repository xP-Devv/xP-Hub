--// FUNÇÕES AUXILIARES
local function IsAlive(char)
    if not char then return false end
    local hum = char:FindFirstChildOfClass("Humanoid")
    return hum and hum.Health > 0
end

local function GetAimPart(char)
    return char:FindFirstChild("HumanoidRootPart") or char.PrimaryPart
end

local function GetAimPosition(part)
    return part.Position + Vector3.new(0, Settings.YOffset, 0)
end

local function IsVisible(character, worldPos)
    if not Settings.VisCheck then return true end
    local origin = Camera.CFrame.Position
    local direction = worldPos - origin
    local rayParams = RaycastParams.new()
    local filter = {Camera}
    if LocalPlayer.Character then
        table.insert(filter, LocalPlayer.Character)
    end
    rayParams.FilterDescendantsInstances = filter
    rayParams.FilterType = Enum.RaycastFilterType.Blacklist
    local result = Workspace:Raycast(origin, direction, rayParams)
    if result and result.Instance then
        return result.Instance:IsDescendantOf(character)
    end
    return true
end

local function IsTargetValid(player)
    if player == LocalPlayer then return false end
    if Settings.TeamCheck and player.Team == LocalPlayer.Team then return false end
    return true
end

--// SKELETON
function GetESP(player)
    if not ESPTable[player] then
        ESPTable[player] = { SkeletonLines = {}, Player = player, Character = nil }
    end
    return ESPTable[player]
end

function RemoveESP(player)
    local data = ESPTable[player]
    if not data then return end
    for _, lineData in ipairs(data.SkeletonLines) do
        if lineData and lineData[1] then pcall(function() lineData[1]:Remove() end) end
    end
    ESPTable[player] = nil
end

function BuildSkeletonLines(char, color)
    local lines = {}
    local function addLine(partA, partB)
        if partA and partB and partA ~= partB and partA.Parent and partB.Parent then
            local line = Drawing.new("Line")
            line.Visible = false
            line.Color = color
            line.Thickness = 1
            line.Transparency = 0.5
            table.insert(lines, {line, partA, partB})
        end
    end

    local upperTorso = char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso")
    local lowerTorso = char:FindFirstChild("LowerTorso") or char:FindFirstChild("Torso")
    local head       = char:FindFirstChild("Head")

    local leftUpperArm  = char:FindFirstChild("LeftUpperArm")  or char:FindFirstChild("Left Arm")
    local leftLowerArm  = char:FindFirstChild("LeftLowerArm")  or char:FindFirstChild("Left Arm")
    local leftHand      = char:FindFirstChild("LeftHand")      or char:FindFirstChild("Left Arm")
    local rightUpperArm = char:FindFirstChild("RightUpperArm") or char:FindFirstChild("Right Arm")
    local rightLowerArm = char:FindFirstChild("RightLowerArm") or char:FindFirstChild("Right Arm")
    local rightHand     = char:FindFirstChild("RightHand")     or char:FindFirstChild("Right Arm")
    local leftUpperLeg  = char:FindFirstChild("LeftUpperLeg")  or char:FindFirstChild("Left Leg")
    local leftLowerLeg  = char:FindFirstChild("LeftLowerLeg")  or char:FindFirstChild("Left Leg")
    local leftFoot      = char:FindFirstChild("LeftFoot")      or char:FindFirstChild("Left Leg")
    local rightUpperLeg = char:FindFirstChild("RightUpperLeg") or char:FindFirstChild("Right Leg")
    local rightLowerLeg = char:FindFirstChild("RightLowerLeg") or char:FindFirstChild("Right Leg")
    local rightFoot     = char:FindFirstChild("RightFoot")     or char:FindFirstChild("Right Leg")

    if upperTorso and lowerTorso and upperTorso ~= lowerTorso then addLine(lowerTorso, upperTorso) end
    addLine(upperTorso, head)
    addLine(upperTorso, leftUpperArm)
    addLine(leftUpperArm, leftLowerArm)
    addLine(leftLowerArm, leftHand)
    addLine(upperTorso, rightUpperArm)
    addLine(rightUpperArm, rightLowerArm)
    addLine(rightLowerArm, rightHand)
    addLine(lowerTorso, leftUpperLeg)
    addLine(leftUpperLeg, leftLowerLeg)
    addLine(leftLowerLeg, leftFoot)
    addLine(lowerTorso, rightUpperLeg)
    addLine(rightUpperLeg, rightLowerLeg)
    addLine(rightLowerLeg, rightFoot)

    return lines
end

function UpdateSkeletonLines(data, char, color)
    if data.Character ~= char then
        for _, lineData in ipairs(data.SkeletonLines) do
            if lineData and lineData[1] then pcall(function() lineData[1]:Remove() end) end
        end
        data.SkeletonLines = {}
        if char then data.SkeletonLines = BuildSkeletonLines(char, color) end
        data.Character = char
    else
        for _, lineData in ipairs(data.SkeletonLines) do
            if lineData and lineData[1] then lineData[1].Color = color end
        end
    end

    if not char or #data.SkeletonLines == 0 then return end

    for _, lineData in ipairs(data.SkeletonLines) do
        local line, partA, partB = lineData[1], lineData[2], lineData[3]
        if line and partA and partB and partA.Parent and partB.Parent then
            local posA, onA = Camera:WorldToViewportPoint(partA.Position)
            local posB, onB = Camera:WorldToViewportPoint(partB.Position)
            if onA and onB then
                line.From = Vector2.new(posA.X, posA.Y)
                line.To   = Vector2.new(posB.X, posB.Y)
                line.Visible = true
            else
                line.Visible = false
            end
        elseif line then
            line.Visible = false
        end
    end
end

--// TRACERS
local function UpdateTracer(player)
    if not Settings.ESPEnabled or not Settings.ESPTracers then
        if TracersTable[player] then TracersTable[player].Visible = false end
        return
    end
    if not IsTargetValid(player) then return end
    local char = player.Character
    if not char or not IsAlive(char) then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return end
    local pos, onScreen = Camera:WorldToViewportPoint(root.Position)
    if not onScreen then return end
    if not TracersTable[player] then
        TracersTable[player] = Drawing.new("Line")
        TracersTable[player].Thickness = 1
        TracersTable[player].Transparency = 0.6
        TracersTable[player].Color = Color3.fromRGB(255, 255, 255)
    end
    local tracer = TracersTable[player]
    tracer.From = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
    tracer.To   = Vector2.new(pos.X, pos.Y)
    tracer.Visible = true
end

--// CLOSEST TARGET
local function GetClosestPlayer()
    local screenCenter = Camera.ViewportSize / 2
    local closest = nil
    local closestDist = math.huge

    for _, player in ipairs(Players:GetPlayers()) do
        if not IsTargetValid(player) then continue end
        local char = player.Character
        local part = char and GetAimPart(char)
        if not part or not IsAlive(char) then continue end
        local aimPos = GetAimPosition(part)
        local pos, onScreen = Camera:WorldToViewportPoint(aimPos)
        if not onScreen then continue end
        local screenDist = (Vector2.new(pos.X, pos.Y) - screenCenter).Magnitude
        if screenDist > Settings.FOV then continue end
        if not IsVisible(char, aimPos) then continue end
        local dist3D = (part.Position - Camera.CFrame.Position).Magnitude
        if dist3D < closestDist then
            closestDist = dist3D
            closest = {
                Player = player, Part = part, Position = pos,
                Distance = dist3D, Notified = false,
            }
        end
    end
    return closest
end

