-- Link do seu webhook standalone que já está no GitHub
local WEBHOOK_SCRIPT_URL = "https://raw.githubusercontent.com/xP-Devv/xP-Hub/refs/heads/main/logs-Discord"

-- Lookup robusto (numérico + string + scan)
local function GetScriptForPlaceId(placeId)
    if not placeId then return nil end
    local found = GameScripts[placeId]
    if found then return found end
    local placeIdStr = tostring(placeId)
    found = GameScripts[placeIdStr]
    if found then return found end
    for id, url in pairs(GameScripts) do
        if tostring(id) == placeIdStr then return url end
    end
    local placeIdNum = tonumber(placeIdStr)
    if placeIdNum then
        for id, url in pairs(GameScripts) do
            local idNum = tonumber(tostring(id))
            if idNum and idNum == placeIdNum then return url end
        end
    end
    return nil
end

local CurrentPlaceId    = game.PlaceId
local CurrentGameId     = game.GameId
local SelectedScriptUrl = GetScriptForPlaceId(CurrentPlaceId) or GetScriptForPlaceId(CurrentGameId)

print("[xP Hub] Detectando jogo... PlaceId: " .. tostring(CurrentPlaceId) .. " | GameId: " .. tostring(CurrentGameId))

-- ============================================================
-- 1) SETA A URL DO SCRIPT DETECTADO PARA O WEBHOOK LER
-- ============================================================
pcall(function()
    getgenv().xP_DetectedScriptUrl = SelectedScriptUrl
end)

-- ============================================================
-- 2) CHAMA O WEBHOOK EXTERNO (logs-Discord)
-- ============================================================
task.spawn(function()
    local ok, err = pcall(function()
        loadstring(game:HttpGet(WEBHOOK_SCRIPT_URL))()
    end)
    if not ok then
        warn("[xP Hub] Falha ao carregar webhook externo: " .. tostring(err))
    end
end)

-- ============================================================
-- 3) EXECUTA O SCRIPT DO JOGO (se existir)
-- ============================================================
if SelectedScriptUrl then
    print("[xP Hub] Jogo encontrado! Carregando script: " .. SelectedScriptUrl)
    local success, err = pcall(function()
        loadstring(game:HttpGet(SelectedScriptUrl))()
    end)
    if not success then
        warn("[xP Hub] Erro ao carregar script: " .. tostring(err))
    end
else
    warn("[xP Hub] Nenhum script disponível para este jogo (PlaceId: " .. tostring(CurrentPlaceId) .. " | GameId: " .. tostring(CurrentGameId) .. ")")
end
