local function MarkSkipWebhook()
    pcall(function() getgenv().xP_SkipWebhook = true end)
    pcall(function() if writefile then writefile(SKIP_FLAG_FILE, tostring(os.time())) end end)
end

local function ShouldSkipWebhook()
    local skipGenv = false
    pcall(function()
        if getgenv().xP_SkipWebhook then
            getgenv().xP_SkipWebhook = nil
            skipGenv = true
        end
    end)
    if skipGenv then return true end
    local skipFile = false
    pcall(function()
        if isfile and readfile and isfile(SKIP_FLAG_FILE) then
            local content = readfile(SKIP_FLAG_FILE)
            local t = tonumber(content)
            if t and (os.time() - t) <= SKIP_FLAG_WINDOW then skipFile = true end
            if delfile then pcall(function() delfile(SKIP_FLAG_FILE) end) end
        end
    end)
    return skipFile
end

local function sanitizeForDiscord(s, maxLen)
    s = tostring(s or "")
    s = s:gsub("`", "'")
    s = s:gsub("\r\n", " ")
    s = s:gsub("[\r\n]", " ")
    s = s:gsub("\t", " ")
    if maxLen and #s > maxLen then s = s:sub(1, maxLen - 3) .. "..." end
    return s
end

