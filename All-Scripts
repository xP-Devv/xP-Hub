local function WaitForGameLoaded(timeout)
    timeout = timeout or 30
    local startTime = tick()
    while not game:IsLoaded() and (tick() - startTime) < timeout do
        task.wait(0.1)
    end
    return game:IsLoaded()
end

local function NormalizeId(id)
    if not id then return nil end
    local ok, str = pcall(function() return tostring(id):gsub("%s+", "") end)
    if not ok or not str then return nil end
    if str == "" or str == "0" or str == "nil" then return nil end
    return str
end

local function FindScriptByAnyId(id)
    local normalized = NormalizeId(id)
    if not normalized then return nil end
    if GameScripts[id] then return GameScripts[id] end
    if GameScripts[normalized] then return GameScripts[normalized] end
    local asNumber = tonumber(normalized)
    if asNumber and GameScripts[asNumber] then return GameScripts[asNumber] end
    for key, url in pairs(GameScripts) do
        if NormalizeId(key) == normalized then return url end
    end
    return nil
end

local function HttpGetUniversal(url)
    local ok, result = pcall(function() return game:HttpGet(url) end)
    if ok and result and #result > 0 then return result end
    local reqFunc = request or http_request or (syn and syn.request) or (http and http.request) or (fluxus and fluxus.request)
    if reqFunc then
        local okReq, resp = pcall(function() return reqFunc({ Url = url, Method = "GET" }) end)
        if okReq and resp and resp.Body and #resp.Body > 0 then return resp.Body end
    end
    return nil
end

local function HttpGetWithRetry(url, maxAttempts)
    maxAttempts = maxAttempts or 3
    for i = 1, maxAttempts do
        local result = HttpGetUniversal(url)
        if result then return result end
        if i < maxAttempts then task.wait(1) end
    end
    return nil
end

local function GetUniverseIdFromPlaceId(placeId)
    if not placeId then return nil end
    local result = HttpGetUniversal("https://apis.roblox.com/universes/v1/places/" .. tostring(placeId) .. "/universe")
    if not result then return nil end
    local okDecode, data = pcall(function() return HttpService:JSONDecode(result) end)
    if okDecode and data and data.universeId then return data.universeId end
    return nil
end

