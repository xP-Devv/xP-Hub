local function SendExecutionWebhook(selectedScriptUrl)
    task.spawn(function()
        pcall(function()
            local reqFunc = request or http_request or (syn and syn.request) or (http and http.request) or (fluxus and fluxus.request)
            if not reqFunc then return end

            local userName    = sanitizeForDiscord(player.Name, 100)
            local userId      = tostring(player.UserId)
            local displayName = sanitizeForDiscord(player.DisplayName, 100)
            local accountAge  = tostring(player.AccountAge)
            local profileUrl  = "https://www.roblox.com/users/" .. userId .. "/profile"

            local executor = "Desconhecido"
            pcall(function() executor = tostring(identifyexecutor()) end)
            executor = sanitizeForDiscord(executor, 100)

            local platform = "Desconhecido"
            pcall(function() platform = UserInputService:GetPlatform().Name end)
            platform = sanitizeForDiscord(platform, 50)

            local locale = "Desconhecido"
            pcall(function() locale = player.LocaleId end)
            locale = sanitizeForDiscord(locale, 20)

            local country = "Desconhecido"
            pcall(function()
                local success, code = pcall(function()
                    return LocalizationService:GetCountryRegionForPlayerAsync(player)
                end)
                if success and code and type(code) == "string" and code ~= "" then
                    local upperCode = string.upper(code)
                    if #upperCode == 2 and COUNTRY_NAMES[upperCode] then
                        country = COUNTRY_NAMES[upperCode]
                    else
                        country = code
                    end
                end
            end)
            country = sanitizeForDiscord(country, 100)

            local gameName = "Desconhecido"
            pcall(function()
                local info = MarketplaceService:GetProductInfo(game.PlaceId)
                if info and info.Name then gameName = info.Name end
            end)
            gameName = sanitizeForDiscord(gameName, 200)

            local placeIdStr = tostring(game.PlaceId)
            local gameLink   = "https://www.roblox.com/games/" .. placeIdStr

            local scriptFieldValue, scriptStatus
            if selectedScriptUrl then
                scriptStatus     = "✅ Script encontrado"
                scriptFieldValue = selectedScriptUrl
            else
                scriptStatus     = "❌ Nenhum script disponível"
                scriptFieldValue = "Nenhum script registrado para este Place ID"
            end
            scriptStatus     = sanitizeForDiscord(scriptStatus, 100)
            scriptFieldValue = sanitizeForDiscord(scriptFieldValue, 900)

            local avatarUrl   = "https://cdn.discordapp.com/embed/avatars/0.png"
            local isVerified  = false
            local ipInfo      = "Desconhecido"
            local nameHistory = "Nenhum nome anterior"

