-- 🎲 SPAWNER
-- ========================================================
local SpawnLeft = Tabs.Spawner:AddLeftGroupbox("Block Spawner", "box")

SpawnLeft:AddDropdown("SelectedBlockDropdown", {
    Values = {
        "LuckyBlock",
        "SuperBlock",
        "DiamondBlock",
        "RainbowBlock",
        "GalaxyBlock",
        "VoidBlock",
    },
    Default = "LuckyBlock",
    Multi = false,
    Text = "Select Block",
    Tooltip = "Escolha o bloco que deseja spawnar",
    Callback = function(Value)
        -- nada por aqui, usado só para seleção
    end,
})

SpawnLeft:AddDivider()

SpawnLeft:AddButton({
    Text = "🎲  Spawn Block",
    Func = function()
        local SelectedBlock = Options.SelectedBlockDropdown.Value

        if SelectedBlock == "VoidBlock" then
            local RainbowEvent = GetRemote("SpawnRainbowBlock")
            local GalaxyEvent  = GetRemote("SpawnGalaxyBlock")
            if RainbowEvent and GalaxyEvent then
                SafeFireBurst(GalaxyEvent, 4, 0.08)
                task.wait(0.15)
                SafeFireBurst(RainbowEvent, 4, 0.08)
                task.wait(0.15)
                SafeFireBurst(RainbowEvent, 2, 0.08)

                Library:Notify({
                    Title = "VoidBlock",
                    Description = "Blocos especiais spawnados!",
                    Time = 3,
                })
            else
                Library:Notify({
                    Title = "Erro",
                    Description = "RemoteEvents não encontrados!",
                    Time = 4,
                })
            end
        else
            local RemoteEvent = GetRemote("Spawn" .. SelectedBlock)
            if RemoteEvent then
                SafeFire(RemoteEvent)
                Library:Notify({
                    Title = "Spawn",
                    Description = SelectedBlock .. " spawnado!",
                    Time = 2,
                })
            else
                Library:Notify({
                    Title = "Erro",
                    Description = "RemoteEvent não encontrado: Spawn" .. SelectedBlock,
                    Time = 4,
                })
            end
        end
    end,
    DoubleClick = false,
    Tooltip = "Spawna o bloco selecionado",
})

