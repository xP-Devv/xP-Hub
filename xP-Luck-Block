-- ========================================================
-- BYPASS LEVE (anti-crash / anti-spam-kick)
-- ========================================================
local _unpack = table.unpack or unpack
local BYPASS_MIN_INTERVAL = 0.10
local BYPASS_MAX_BURST   = 8
local lastFireTimes = {}

local function SafeFire(remote, ...)
    if type(remote) ~= "userdata" and type(remote) ~= "table" then return false end
    if not remote or not remote.Parent then return false end
    local ok, isRemote = pcall(function() return remote:IsA("RemoteEvent") end)
    if not ok or not isRemote then return false end

    local now = os.clock()
    local last = lastFireTimes[remote] or 0
    if (now - last) < BYPASS_MIN_INTERVAL then
        return false
    end
    lastFireTimes[remote] = now

    local args = {...}
    local success = pcall(function()
        remote:FireServer(_unpack(args))
    end)
    return success
end

local function SafeFireBurst(remote, count, delayBetween)
    count = math.min(count or 1, BYPASS_MAX_BURST)
    delayBetween = delayBetween or 0.08
    task.spawn(function()
        for i = 1, count do
            if not remote or not remote.Parent then break end
            SafeFire(remote)
            if i < count then
                task.wait(delayBetween)
            end
        end
    end)
end

local function GetRemote(name)
    if not name then return nil end
    local ok, remote = pcall(function()
        return ReplicatedStorage:FindFirstChild(name)
    end)
    if ok and remote and remote:IsA("RemoteEvent") then
        return remote
    end
    return nil
end

