-- ============================================================
-- SALVAR / RESTAURAR ESTADO ORIGINAL
-- ============================================================
local function saveOriginal(part)
    if originals[part] then return end

    originals[part] = {
        canCollide    = part.CanCollide,
        canTouch      = part.CanTouch,
        canQuery      = part.CanQuery,
        massless      = part.Massless,
        customPhysics = part.CustomPhysicalProperties,
    }
end

local function restoreOriginal(part)
    local orig = originals[part]
    if not (orig and part.Parent) then return end

    pcall(function()
        part.CanCollide   = orig.canCollide
        part.CanTouch     = orig.canTouch
        part.CanQuery     = orig.canQuery
        part.Massless     = orig.massless
        if orig.customPhysics then
            part.CustomPhysicalProperties = orig.customPhysics
        end
    end)

    for _, name in ipairs({"xP_Torque", "xP_Align", "xP_Attach"}) do
        local c = part:FindFirstChild(name)
        if c then c:Destroy() end
    end

    originals[part] = nil
end

-- ============================================================
-- FORÇA A PARTE A IR PRO ALVO
-- ============================================================
local function forcePart(v)
    if not (v:IsA("BasePart") and not v.Anchored) then return end

    local parent = v.Parent
    if not parent then return end
    if parent:FindFirstChildOfClass("Humanoid") then return end
    if parent:FindFirstChild("Head") then return end
    if v.Name == "Handle" then return end

    if v:FindFirstChild("xP_Align") then return end

    saveOriginal(v)

    for _, x in ipairs(v:GetChildren()) do
        if x:IsA("BodyMover") or x:IsA("RocketPropulsion") then
            pcall(function() x:Destroy() end)
        end
    end

    pcall(function()
        v.CanCollide = false
        v.CanTouch  = false
        v.CanQuery  = false
        v.Massless  = true
        v.CustomPhysicalProperties = PhysicalProperties.new(0, 0, 0, 0, 0)
    end)

    local attach = Instance.new("Attachment")
    attach.Name = "xP_Attach"
    attach.Parent = v

    local torque = Instance.new("Torque")
    torque.Name = "xP_Torque"
    torque.Torque = Vector3.new(1e5, 1e5, 1e5)
    torque.Attachment0 = attach
    torque.Parent = v

    local align = Instance.new("AlignPosition")
    align.Name = "xP_Align"
    align.MaxForce = math.huge
    align.MaxVelocity = math.huge
    align.Responsiveness = 200
    align.Attachment0 = attach
    align.Attachment1 = Attachment1
    align.Parent = v
end

-- ============================================================
-- RESTAURAR TODAS AS PARTES
-- ============================================================
local function restoreAllParts()
    local snapshot = {}
    for part in pairs(originals) do
        snapshot[#snapshot + 1] = part
    end
    for _, part in ipairs(snapshot) do
        restoreOriginal(part)
    end
    table.clear(originals)
end

-- ============================================================
-- TOGGLE BLACK HOLE
-- ============================================================
local function toggleBlackHole()
    blackHoleActive = not blackHoleActive

    if blackHoleActive then
        Button.Text = "DESATIVAR BLACK HOLE"
        Button.BackgroundColor3 = Color3.fromRGB(200, 50, 50)

        for _, v in ipairs(Workspace:GetDescendants()) do
            forcePart(v)
        end

        descendantConn = track(Workspace.DescendantAdded:Connect(function(v)
            if blackHoleActive then
                forcePart(v)
            end
        end))

        task.spawn(function()
            while blackHoleActive do
                RunService.RenderStepped:Wait()
                if humanoidRootPart and humanoidRootPart.Parent then
                    Attachment1.WorldCFrame = humanoidRootPart.CFrame
                end
            end
        end)
    else
        Button.Text = "ATIVAR BLACK HOLE"
        Button.BackgroundColor3 = Color3.fromRGB(60, 60, 70)

        if descendantConn then
            descendantConn:Disconnect()
            descendantConn = nil
        end

        restoreAllParts()
    end
end

-- ============================================================
-- SELECIONAR ALVO
-- ============================================================
local function setTargetPlayer(player)
    if not player then
        playerSelected = nil
        character = nil
        humanoidRootPart = nil
        SelectedLabel.Text = "Selecionado: Nenhum"
        if blackHoleActive then toggleBlackHole() end
        return
    end

    playerSelected = player
    SelectedLabel.Text = "Selecionado: " .. player.Name
    Notify("Alvo definido", player.Name, 2)

    if currentCharConn then currentCharConn:Disconnect() end

    local function updateChar()
        character = playerSelected.Character
        humanoidRootPart = character and character:FindFirstChild("HumanoidRootPart")
    end

    updateChar()
    currentCharConn = playerSelected.CharacterAdded:Connect(updateChar)
end

-- ============================================================
-- FERRAMENTA SELECT PLAYER
-- ============================================================
local function createTargetTool()
    local backpack = LP:FindFirstChildOfClass("Backpack")
    local char = LP.Character

    if (backpack and backpack:FindFirstChild("SelectTarget"))
        or (char and char:FindFirstChild("SelectTarget")) then
        Notify("Aviso", "Ferramenta já existe!", 2)
        return
    end
    if not backpack then
        Notify("Erro", "Backpack não encontrado.", 2)
        return
    end

    local tool = Instance.new("Tool")
    tool.Name = "SelectTarget"
    tool.RequiresHandle = false
    tool.ToolTip = "Clique em um player para selecionar"
    tool.TextureId = "rbxassetid://2716591855"
    tool.Parent = backpack

    local mouse = LP:GetMouse()

    tool.Activated:Connect(function()
        local targetPart = mouse.Target
        if not targetPart then
            Notify("Nenhum", "Mire em um player.", 2)
            return
        end

        local targetPlayer
        local obj = targetPart
        while obj and obj ~= Workspace do
            local p = Players:GetPlayerFromCharacter(obj)
            if p then targetPlayer = p break end
            obj = obj.Parent
        end

        if not targetPlayer then
            Notify("Nenhum", "Clique em player válido.", 2)
        elseif targetPlayer == LP then
            Notify("Inválido", "Não pode se selecionar!", 2)
        else
            setTargetPlayer(targetPlayer)
        end
    end)

    Notify("Ferramenta criada", "SelectTarget adicionada!", 3)
end

